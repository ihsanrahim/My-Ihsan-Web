","Tepi","Bucu"],"baris":[["kubus","6","12","8"],["kuboid","6","12","8"],["silinder","3","2","0"],["kon","2","1","1"],["piramid tapak segi empat","5","8","5"]]},{"j":"h","t":"Bentuk 2D"},{"j":"p","t":"Kira <b>sisi</b> dan <b>bucu</b>."},{"j":"h","t":"Bentuk tiga dimensi"},{"j":"t","kepala":["Bentuk","Contoh objek"],"baris":[["kubus","🎲 🎲"],["kuboid","📦 📦"],["silinder","🥫 🥫"],["kon","🍦 🍦"],["sfera","⚽ ⚽"],["piramid","🔺 🔺"]]}],"glosari":[["tepi","Garis pertemuan dua permukaan."],["bucu","Titik pertemuan tepi."]]},{"id":"t2-mat-8","nama":"Pengurusan Data","nota":[{"j":"h","t":"Piktograf dan carta palang"},{"j":"p","t":"<b>Carta palang</b> menggunakan palang untuk mewakili data. Palang yang lebih <b>panjang</b> bermaksud bilangan yang lebih <b>banyak</b>."},{"j":"lk","t":["Baca tajuk dan skala.","Banding palang: paling panjang, paling pendek."]}],"glosari":[["carta palang","Carta yang menggunakan palang untuk mewakili data."],["skala","Nilai yang diwakili oleh setiap garis pada carta."]]}]}