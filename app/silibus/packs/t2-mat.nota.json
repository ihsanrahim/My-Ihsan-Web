{"id":"t2-mat","tahap":"T2","nama":"Matematik","sk":"MT","ikon":"🔢","warna":"#F0A030","bahasa":"ms","kur":"KSSR-S2017","semak":"pending-guru","jawi":false,"versi":1,"sumber":"DSKP Matematik KSSR (Semakan 2017) Tahun 2; susunan tajuk buku teks Tahun 2","topik":[{"id":"t2-mat-1","nama":"Nombor Bulat hingga 1 000","nota":[{"j":"h","t":"Nilai tempat"},{"j":"t","kepala":["Ratus","Puluh","Sa"],"baris":[["3","4","7"]]},{"j":"c","t":"347 = 300 + 40 + 7 · tiga ratus empat puluh tujuh"},{"j":"h","t":"Membundar"},{"j":"p","t":"Bundarkan kepada <b>puluh terdekat</b>: lihat digit sa. <b>0–4</b> → kekal; <b>5–9</b> → naik."},{"j":"c","t":"347 → <b>350</b> · 342 → <b>340</b>"}],"glosari":[["membundar","Menganggar nombor kepada puluh atau ratus yang terdekat."],["nilai digit","Nilai sebenar sesuatu digit mengikut tempatnya."]]},{"id":"t2-mat-2","nama":"Operasi Asas: Tambah, Tolak, Darab, Bahagi","nota":[{"j":"h","t":"Tambah dan tolak hingga 1 000"},{"j":"p","t":"Mulakan dari lajur <b>sa</b>, kemudian <b>puluh</b>, kemudian <b>ratus</b>. Kumpul semula jika perlu."},{"j":"h","t":"Darab"},{"j":"p","t":"Darab ialah <b>tambah berulang</b>. > 4 × 3 = 3 + 3 + 3 + 3 = 12"},{"j":"p","t":"Sifir 2, 3, 4, 5 dan 10."},{"j":"h","t":"Bahagi"},{"j":"p","t":"Bahagi ialah <b>kongsi sama banyak</b> atau <b>tolak berulang</b>. > 12 ÷ 3 = 4 kerana 4 × 3 = 12"},{"j":"tt","t":"Darab dan bahagi ialah operasi <b>songsang</b>."}],"glosari":[["hasil darab","Jawapan bagi operasi darab."],["hasil bahagi","Jawapan bagi operasi bahagi."],["sifir","Senarai hasil darab sesuatu nombor."]]},{"id":"t2-mat-3","nama":"Pecahan dan Perpuluhan","nota":[{"j":"h","t":"Pecahan"},{"j":"p","t":"Pecahan wajar: pengangka lebih kecil daripada penyebut. > 3/5 · 5/8 · 7/10"},{"j":"h","t":"Perpuluhan"},{"j":"p","t":"Perpuluhan menggunakan <b>titik perpuluhan</b>. > 3/10 = <b>0.3</b> · 7/10 = <b>0.7</b>"},{"j":"t","kepala":["Pecahan","Perpuluhan","Sebutan"],"baris":[["1/10","0.1","sifar perpuluhan satu"],["5/10","0.5","sifar perpuluh