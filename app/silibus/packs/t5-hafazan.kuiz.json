<span class=\"arab\">بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا</span>","<span class=\"arab\">إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ</span>"],"a":"<span class=\"arab\">إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا</span>","aras":3,"id":"t5-hafazan-1.6cef7b"}]},{"id":"t5-hafazan-2","nama":"Surah Al-Mutaffifin","soalan":[{"j":"mcq","s":"Surah Al-Mutaffifin mempunyai ______ ayat.","p":["tiga puluh enam","tiga puluh empat","tiga puluh lima","tiga puluh tujuh"],"a":"tiga puluh enam","aras":1,"id":"t5-hafazan-2.a7296e"},{"j":"mcq","s":"Surah Al-Mutaffifin ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t5-hafazan-2.2b59fe"},{"j":"mcq","s":"Maksud nama Surah Al-Mutaffifin ialah ______.","p":["Orang yang curang dalam timbangan","Menggulung"],"a":"Orang yang curang dalam timbangan","aras":1,"id":"t5-hafazan-2.a87555"},{"j":"mcq","s":"Ayat pertama Surah Al-Mutaffifin ialah ______.","p":["<span class=\"arab\">وَيْلٌ لِّلْمُطَفِّفِينَ</span>","<span class=\"arab\">إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ</span>","<span class=\"arab\">إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ</span>","<span class=\"arab\">إِذَا ٱلشَّمْسُ كُوِّرَتْ</span>"],"a":"<span class=\"arab\">وَيْلٌ لِّلْمُطَفِّفِينَ</span>","aras":2,"id":"t5-hafazan-2.ed19c2"},{"j":"isi","s":"Surah Al-Mutaffifin ialah surah yang ke-83 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t5-hafazan-2.2ced4e"},{"j":"bs","s":"Surah Al-Mutaffifin ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t5-hafazan-2.806b94"},{"j":"bs","s":"Surah Al-Mutaffifin mempunyai tiga puluh tujuh ayat.","a":"Salah","aras":1,"id":"t5-hafazan-2.1ba7c6"},{"j":"mcq","s":"Ayat terakhir Surah Al-Mutaffifin ialah ______.","p":["<span class=\"arab\">هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُواْ يَفْعَلُونَ</span>","<span class=\"arab\">يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْــًٔا‌ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ</span>","<span class=\"arab\">وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ</span>"],"a":"<span class=\"arab\">هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُواْ يَفْعَلُونَ</span>","aras":3,"id":"t5-hafazan-2.398674"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">وَيْلٌ لِّلْمُطَفِّفِينَ</span> ialah ______.","p":["<span class=\"arab\">ٱلَّذِينَ إِذَا ٱكْتَالُواْ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ</span>","<span class=\"arab\">وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ</span>","<span class=\"arab\">أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ</span>","<span class=\"arab\">لِيَوْمٍ عَظِيمٍ</span>"],"a":"<span class=\"arab\">ٱلَّذِينَ إِذَا ٱكْتَالُواْ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ</span>","aras":3,"id":"t5-hafazan-2.ec5990"},{"j":"susun","s":"Susun ayat Surah Al-Mutaffifin.","susunan":["وَيْلٌ لِّلْمُطَفِّفِينَ","ٱلَّذِينَ إِذَا ٱكْتَالُواْ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","لِيَوْمٍ عَظِيمٍ"],"aras":3,"id":"t5-hafazan-2.6803a9"},{"j":"bs","s":"Kita tidak menipu dalam jual beli.","a":"Betul","aras":1,"id":"t5-hafazan-2.786aed"},{"j":"mcq","s":"Pengajaran Surah Al-Mutaffifin ialah ______.","p":["menipu ialah dosa besar dan ciri orang munafik","kita berusaha supaya menerima buku amalan dengan tangan kanan","malaikat mencatat semua amalan kita","kita menjadikan al-Quran panduan hidup"],"a":"menipu ialah dosa besar dan ciri orang munafik","aras":2,"id":"t5-hafazan-2.71d5cf"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-Mutaffifin.","susunan":["وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَـٰفِظِينَ","فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُواْ يَفْعَلُونَ"],"aras":3,"id":"t5-hafazan-2.c1516a"},{"j":"mcq","s":"Ayat ke-19 Surah Al-Mutaffifin ialah ______.","p":["<span class=\"arab\">وَمَآ أَدْرَٮٰكَ مَا عِلِّيُّونَ</span>","<span class=\"arab\">ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ</span>","<span class=\"arab\">يَشْهَدُهُ ٱلْمُقَرَّبُونَ</span>","