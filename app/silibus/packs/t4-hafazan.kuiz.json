"s":"Surah Al-Balad mempunyai ______ ayat.","p":["dua puluh","lapan belas","sembilan belas","dua puluh satu"],"a":"dua puluh","aras":1,"id":"t4-hafazan-2.821867"},{"j":"mcq","s":"Surah Al-Balad ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t4-hafazan-2.8a7caa"},{"j":"mcq","s":"Maksud nama Surah Al-Balad ialah ______.","p":["Negeri","Matahari","Waktu fajar","Hari kiamat yang menyelubungi"],"a":"Negeri","aras":1,"id":"t4-hafazan-2.09004c"},{"j":"mcq","s":"Ayat pertama Surah Al-Balad ialah ______.","p":["<span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span>","<span class=\"arab\">وَٱلشَّمْسِ وَضُحَـٰهَا</span>","<span class=\"arab\">وَٱلْفَجْرِ</span>","<span class=\"arab\">هَلْ أَتَـٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ</span>"],"a":"<span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span>","aras":2,"id":"t4-hafazan-2.95a212"},{"j":"isi","s":"Surah Al-Balad ialah surah yang ke-90 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t4-hafazan-2.c5a2e2"},{"j":"bs","s":"Surah Al-Balad ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t4-hafazan-2.5d6e78"},{"j":"bs","s":"Surah Al-Balad mempunyai dua puluh satu ayat.","a":"Salah","aras":1,"id":"t4-hafazan-2.7fa60d"},{"j":"mcq","s":"Ayat terakhir Surah Al-Balad ialah ______.","p":["<span class=\"arab\">عَلَيْهِمْ نَارٌ مُّؤْصَدَةُۢ</span>","<span class=\"arab\">وَٱدْخُلِى جَنَّتِى</span>","<span class=\"arab\">ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم</span>","<span class=\"arab\">صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ</span>"],"a":"<span class=\"arab\">عَلَيْهِمْ نَارٌ مُّؤْصَدَةُۢ</span>","aras":3,"id":"t4-hafazan-2.ce9892"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span> ialah ______.","p":["<span class=\"arab\">وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلْبَلَدِ</span>","<span class=\"arab\">وَوَالِدٍ وَمَا وَلَدَ</span>","<span class=\"arab\">لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ</span>","<span class=\"arab\">أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ</span>"],"a":"<span class=\"arab\">وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلْبَلَدِ</span>","aras":3,"id":"t4-hafazan-2.1ef337"},{"j":"susun","s":"Susun ayat Surah Al-Balad.","susunan":["لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ","وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلْبَلَدِ","وَوَالِدٍ وَمَا وَلَدَ","لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ","أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"],"aras":3,"id":"t4-hafazan-2.5c32da"},{"j":"bs","s":"Kita memberi makan anak yatim dan orang miskin.","a":"Betul","aras":1,"id":"t4-hafazan-2.2db45a"},{"j":"mcq","s":"Pengajaran Surah Al-Balad ialah ______.","p":["kita berpesan-pesan dengan sabar dan kasih sayang","orang yang mengotori jiwanya akan rugi","kita memuliakan anak yatim","hari kiamat pasti berlaku"],"a":"kita berpesan-pesan dengan sabar dan kasih sayang","aras":2,"id":"t4-hafazan-2.e08b35"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-Balad.","susunan":["ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِٱلصَّبْرِ وَتَوَاصَوْاْ بِٱلْمَرْحَمَةِ","أُوْلَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","وَٱلَّذِينَ كَفَرُواْ بِـَٔـايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْــَٔمَةِ","عَلَيْهِمْ نَارٌ مُّؤْصَدَةُۢ"],"aras":3,"id":"t4-hafazan-2.3f3e8f"},{"j":"mcq","s":"Ayat ke-11 Surah Al-Balad ialah ______.","p":["<span class=\"arab\">فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ</span>","<span class=\"arab\">وَلِسَانًا وَشَفَتَيْنِ</span>","<span class=\"arab\">فَكُّ رَقَبَةٍ</span>","<span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span>"],"a":"<span class=\"arab\">فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ</span>","aras":3,"id":"t4-hafazan-2.13b82f"}]},{"id":"t4-hafazan-3","nama":"Surah Al-Fajr","soalan":[{"j":"mcq","s":"Surah Al-Fajr mempunyai ______ ayat.","p":["tiga puluh","dua puluh lapan","dua puluh sembilan","tiga puluh satu"],"a":"tiga puluh","aras":1,"id":"t4-hafazan-3.db4c69"},{"j":"mcq","s":"Surah Al-Fajr ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t4-hafazan-3.038e4b"},{"j":"mcq","s":"Maksud nama Surah Al-Fajr ialah ______.","p":["Waktu fajar","Hari kiamat yang menyelubungi","Yang Maha Tinggi","Yang datang pada waktu malam"],"a":"Waktu fajar","aras":1,"id":"t4-hafazan-3.1bbb3d"},{"j":"mcq","s":"Ayat pertama Surah Al-Fajr ialah ______.","p":["<span class=\"arab\">وَٱلْفَجْرِ</span>","<span class=\"arab\">وَٱلشَّمْسِ وَضُحَـٰهَا</span>","<span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span>","<span class=\"arab\">هَلْ أَتَـٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ</span>"],"a":"<span class=\"arab\">وَٱلْفَجْرِ</span>","aras":2,"id":"t4-hafazan-3.a60fe6"},{"j":"isi","s":"Surah Al-Fajr ialah surah yang ke-89 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t4-hafazan-3.e8bda4"},{"j":"bs","s":"Surah Al-Fajr ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t4-hafazan-3.134604"},{"j":"bs","s":"Surah Al-Fajr mempunyai tiga puluh satu ayat.","a":"Salah","aras":1,"id":"t4-hafazan-3.4a486a"},{"j":"mcq","s":"Ayat terakhir Surah Al-Fajr ialah ______.","p":["<span class=\"arab\">وَٱدْخُلِى جَنَّتِى</span>","<span class=\"arab\">عَلَيْهِمْ نَارٌ مُّؤْصَدَةُۢ</span>","<span class=\"arab\">ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم</span>","<span class=\"arab\">صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ</span>"],"a":"<span class=\"arab\">وَٱدْخُلِى جَنَّتِى</span>","aras":3,"id":"t4-hafazan-3.afc9ee"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">وَٱلْفَجْرِ</span> ialah ______.","p":["<span class=\"arab\">وَلَيَالٍ عَشْرٍ</span>","<span class=\"arab\">وَٱلشَّفْعِ وَٱلْوَتْرِ</span>","<span class=\"arab\">وَٱلَّيْلِ إِذَا يَسْرِ</span>","<span class=\"arab\">هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ</span>"],"a":"<span class=\"arab\">وَلَيَالٍ عَشْرٍ</span>","aras":3,"id":"t4-hafazan-3.c74467"},{"j":"susun","s":"Susun ayat Surah Al-Fajr.","susunan":["وَٱلْفَجْرِ","وَلَيَالٍ عَشْرٍ","وَٱلشَّفْعِ وَٱلْوَتْرِ","وَٱلَّيْلِ إِذَا يَسْرِ","هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"],"aras":3,"id":"t4-hafazan-3.089dfb"},{"j":"bs","s":"Kita bersyukur ketika senang dan sabar ketika susah.","a":"Betul","aras":1,"id":"t4-hafazan-3.38181e"},{"j":"mcq","s":"Pengajaran Surah Al-Fajr ialah ______.","p":["kita memuliakan anak yatim","orang yang mengotori jiwanya akan rugi","kita berpesan-pesan dengan sabar dan kasih sayang","hari kiamat pasti berlaku"],"a":"kita memuliakan anak yatim","aras":2,"id":"t4-hafazan-3.5ed6d8"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-Fajr.","susunan":["يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","فَٱدْخُلِى فِى عِبَـٰدِى","وَٱدْخُلِى جَنَّتِى"],"aras":3,"id":"t4-hafazan-3.9f27e3"},{"j":"mcq","s":"Ayat ke-16 Surah Al-Fajr ialah ______.","p":["<span class=\"arab\">وَأَمَّآ إِذَا مَا ٱبْتَلَـٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ</span>","<span class=\"arab\">إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ</span>","<span class=\"arab\">وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ</span>","<span class=\"arab\">وَٱلْفَجْرِ</span>"],"a":"<span class=\"arab\">وَأَمَّآ إِذَا مَا ٱبْتَلَـٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ</span>","aras":3,"id":"t4-hafazan-3.01a02b"}]},{"id":"t4-hafazan-4","nama":"Surah Al-Ghasyiyah","soalan":[{"j":"mcq","s":"Surah Al-Ghasyiyah mempunyai ______ ayat.","p":["dua puluh enam","dua puluh empat","dua puluh lima","dua puluh tujuh"],"a":"dua puluh enam","aras":1,"id":"t4-hafazan-4.13e11f"},{"j":"mcq","s":"Surah Al-Ghasyiyah ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t4-hafazan-4.2b9501"},{"j":"mcq","s":"Maksud nama Surah Al-Ghasyiyah ialah ______.","p":["Hari kiamat yang menyelubungi","Negeri","Waktu fajar","Yang Maha Tinggi"],"a":"Hari kiamat yang menyelubungi","aras":1,"id":"t4-hafazan-4.755487"},{"j":"mcq","s":"Ayat pertama Surah Al-Ghasyiyah ialah ______.","p":["<span class=\"arab\">هَلْ أَتَـٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ</span>","<span class=\"arab\">وَٱلشَّمْسِ وَضُحَـٰهَا</span>","<span class=\"arab\">لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ</span