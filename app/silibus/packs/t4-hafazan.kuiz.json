 yang selepas <span class=\"arab\">وَٱلسَّمَآءِ وَٱلطَّارِقِ</span> ialah ______.","p":["<span class=\"arab\">وَمَآ أَدْرَٮٰكَ مَا ٱلطَّارِقُ</span>","<span class=\"arab\">ٱلنَّجْمُ ٱلثَّاقِبُ</span>","<span class=\"arab\">إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ</span>","<span class=\"arab\">فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ</span>"],"a":"<span class=\"arab\">وَمَآ أَدْرَٮٰكَ مَا ٱلطَّارِقُ</span>","aras":3,"id":"t4-hafazan-6.b3901c"},{"j":"susun","s":"Susun ayat Surah At-Tariq.","susunan":["وَٱلسَّمَآءِ وَٱلطَّارِقِ","وَمَآ أَدْرَٮٰكَ مَا ٱلطَّارِقُ","ٱلنَّجْمُ ٱلثَّاقِبُ","إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"],"aras":3,"id":"t4-hafazan-6.a59de8"},{"j":"bs","s":"Setiap jiwa dijaga oleh malaikat.","a":"Betul","aras":1,"id":"t4-hafazan-6.efc0de"},{"j":"mcq","s":"Pengajaran Surah At-Tariq ialah ______.","p":["al-Quran membezakan yang benar dan yang salah","orang yang mengotori jiwanya akan rugi","kita berpesan-pesan dengan sabar dan kasih sayang","kita memuliakan anak yatim"],"a":"al-Quran membezakan yang benar dan yang salah","aras":2,"id":"t4-hafazan-6.ce861d"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah At-Tariq.","susunan":["وَمَا هُوَ بِٱلْهَزْلِ","إِنَّهُمْ يَكِيدُونَ كَيْدًا","وَأَكِيدُ كَيْدًا","فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا"],"aras":3,"id":"t4-hafazan-6.62de03"},{"j":"mcq","s":"Ayat ke-9 Surah At-Tariq ialah ______.","p":["<span class=\"arab\">يَوْمَ تُبْلَى ٱلسَّرَآئِرُ</span>","<span class=\"arab\">يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ</span>","<span class=\"arab\">وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ</span>","<span class=\"arab\">وَٱلسَّمَآءِ وَٱلطَّارِقِ</span>"],"a":"<span class=\"arab\">يَوْمَ تُبْلَى ٱلسَّرَآئِرُ</span>","aras":3,"id":"t4-hafazan-6.3b14cc"}]},{"id":"t4-hafazan-7","nama":"Surah Al-Buruj","soalan":[{"j":"mcq","s":"Surah Al-Buruj mempunyai ______ ayat.","p":["dua puluh dua","dua puluh","dua puluh satu","dua puluh tiga"],"a":"dua puluh dua","aras"