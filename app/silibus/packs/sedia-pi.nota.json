{"id":"sedia-pi","tahap":"PRA","nama":"Pendidikan Islam","sk":"PI","ikon":"🕋","warna":"#1FA37A","bahasa":"ms","kur":"KSPK / kemasukan Tahun 1","semak":"pending-ustaz","jawi":false,"versi":1,"sumber":"Kemahiran asas kesediaan Tahun 1 (KSPK) dan format lazim ujian kemasukan sekolah rendah agama/Islam","topik":[{"id":"sedia-pi-1","nama":"Rukun Iman","nota":[{"j":"h","t":"Rukun Iman ada 6"},{"j":"o","t":["Beriman kepada Allah","Beriman kepada malaikat","Beriman kepada kitab-kitab","Beriman kepada rasul-rasul","Beriman kepada hari akhirat","Beriman kepada qada' dan qadar"]}],"glosari":[["rukun","Perkara asas yang wajib."],["iman","Percaya dengan sepenuh hati."]]},{"id":"sedia-pi-2","nama":"Rukun Islam","nota":[{"j":"h","t":"Rukun Islam ada 5"},{"j":"o","t":["Mengucap dua kalimah syahadah","Mendirikan solat","Berpuasa pada bulan Ramadan","Mengeluarkan zakat","Menunaikan haji bagi yang mampu"]}],"glosari":[]},{"id":"sedia-pi-3","nama":"Allah Pencipta","nota":[{"j":"h","t":"Ciptaan Allah"},{"j":"p","t":"Allah mencipta <b>langit, bumi, matahari, bulan, bintang, manusia, haiwan dan tumbuhan</b>."},{"j":"h","t":"Buatan manusia"},{"j":"p","t":"Kereta, rumah, kerusi dan telefon dibuat oleh manusia — menggunakan bahan ciptaan Allah."},{"j":"c","t":"Kita bersyukur dengan mengucapkan <b>Alhamdulillah</b>."}],"glosari":[["ciptaan Allah","Segala yang dijadikan oleh Allah."]]},{"id":"sedia-pi-4","nama":"Wuduk","nota":[{"j":"h","t":"Anggota wuduk (urutan amalan)"},{"j":"o","t":["Basuh kedua-dua tangan 🤲","Berkumur-kumur 👄","Memasukkan air ke hidung 👃","Basuh muka 🙂 (rukun)","Basuh tangan hingga siku 💪 (rukun)","Sapu sebahagian kepala 🧕 (rukun)","Basuh telinga 👂","Basuh kaki hingga buku lali 🦶 (rukun)"]},{"j":"tt","t":"Mulakan dengan <b>niat</b> dan <b>Bismillah</b>. Dahulukan anggota <b>kanan</b>."}],"glosari":[["wuduk","Cara bersuci sebelum solat dan memegang al-Quran."],["buku lali","Tulang yang menonjol di pergelangan kaki."]]},{"id":"sedia-pi-5","nama":"Solat Fardu","nota":[{"j":"h","t":"Solat lima waktu"},{"j":"t","kepala":["Waktu","Rakaat"],"baris":[["Subuh","2"],["Zohor","4"],["Asar","4"],["Maghrib","3"],["Isyak","4"]]},{"j":"p","t":"Jumlah: <b>17 rakaat</b> sehari semalam. Solat menghadap <b>kiblat</b> (Kaabah di Makkah)."}],"glosari":[["rakaat","Satu pusingan dalam solat."],["kiblat","Arah Kaabah di Makkah."]]},{"id":"sedia-pi-6","nama":"Nabi Muhammad s.a.w. dan Adab","nota":[{"j":"h","t":"Nabi Muhammad s.a.w."},{"j":"p","t":"Lahir di <b>Makkah</b> pada <b>12 Rabiulawal</b>, Tahun Gajah. Bapa: <b>Abdullah</b>. Ibu: <b>Aminah</b>. Datuk: <b>Abdul Muttalib</b>. Bapa saudara: <b>Abu Talib</b>. Gelaran: <b>Al-Amin</b> (yang dipercayai)."},{"j":"h","t":"Adab harian"},{"j":"p","t":"Baca <b>Bismillah</b> sebelum makan · <b>Alhamdulillah</b> selepas makan · beri <b>salam</b> · makan dengan tangan <b>kanan</b> · hormat ibu bapa dan guru"}],"glosari":[["Al-Amin","Gelaran Nabi Muhammad s.a.w. yang bermaksud orang yang amanah dan dipercayai."]]}]}