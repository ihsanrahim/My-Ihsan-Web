{"id":"t3-arab-kafa","tahap":"T3","nama":"Bahasa Arab (KAFA)","sk":"Bahasa Arab","ikon":"🕌","warna":"#C0703A","bahasa":"ms","kur":"KAFA Tahun 3 (ikut e-buku Bahasa Arab Tahun 3)","semak":"pending teacher review","jawi":true,"versi":"0.5.67","sumber":"Original notes and questions following the lessons of the owner's e-BOOK BAHASA ARAB Tahun 3 (JAIS); Arabic vocabulary from the book; shown in full Jawi.","topik":[{"id":"t3-arab-kafa-1","nama":"Nombor 201 hingga 300","nota":[{"j":"h","t":"Nombor 201 hingga 300"},{"j":"p","t":"<span class=\"arab\">مِائَتَانِ</span> bermaksud dua ratus dan <span class=\"arab\">ثَلَاثُمِائَةٍ</span> bermaksud tiga ratus. Untuk nombor selepas dua ratus, kita sebut <span class=\"arab\">مِائَتَانِ</span> dan <span class=\"arab\">وَ</span> diikuti nombor kecil."},{"j":"l","t":["<span class=\"arab\">مِائَتَانِ وَوَاحِدٌ</span> : 201","<span class=\"arab\">مِائَتَانِ وَاثْنَانِ</span> : 202","<span class=\"arab\">مِائَتَانِ وَخَمْسَةٌ</span> : 205","<span class=\"arab\">مِائَتَانِ وَعَشَرَةٌ</span> : 210","<span class=\"arab\">مِائَتَانِ وَأَحَدَ عَشَرَ</span> : 211","<span class=\"arab\">مِائَتَانِ وَعِشْرُونَ</span> : 220","<span class=\"arab\">مِائَتَانِ وَخَمْسُونَ</span> : 250","<span class=\"arab\">مِائَتَانِ وَسَبْعُونَ</span> : 270","<span class=\"arab\">مِائَتَانِ وَتِسْعُونَ</span> : 290","<span class=\"arab\">ثَلَاثُمِائَةٍ</span> : 300"]},{"j":"h","t":"Perbualan"},{"j":"l","t":["<span class=\"arab\">كَمْ سِعْرُ الدَّرَّاجَةِ؟</span> : Berapakah harga basikal?","<span class=\"arab\">الدَّرَّاجَةُ بِمِائَتَيْنِ وَسِتَّةِ رِنْجِيتَاتٍ</span> : Basikal itu berharga 206 ringgit.","<span class=\"arab\">كَمْ</span> : berapa","<span class=\"arab\">سِعْرٌ</span> : harga"]}],"glosari":[["Dua ratus","<span class=\"arab\">مِائَتَانِ</span>"],["Tiga ratus","<span class=\"arab\">ثَلَاثُمِائَةٍ</span>"],["Harga","<span class=\"arab\">سِعْرٌ</span>"]]},{"id":"t3-arab-kafa-2","nama":"Peralatan rumah","nota":[{"j":"h","t":"Peralatan rumah"},{"j":"p","t":"Kita belajar nama perabot dan peralatan elektrik di rumah dalam bahasa Arab. <span class=\"arab\">أَثَاثُ الْبَيْتِ</span> bermaksud perabot rumah."},{"j":"l","t":["<span class=\"arab\">سَرِيرٌ</span> : katil","<span class=\"arab\">أَرِيكَةٌ</span> : sofa","<span class=\"arab\">مِرْآةٌ</span> : cermin","<span class=\"arab\">دُرْجٌ</span> : laci","<span class=\"arab\">كُرْسِيٌّ</span> : kerusi","<span class=\"arab\">مِنْضَدَةٌ</span> : meja","<span class=\"arab\">خِزَانَةٌ</span> : almari","<span class=\"arab\">مِصْبَاحٌ</span> : lampu","<span class=\"arab\">ثَلَّاجَةٌ</span> : peti sejuk","<span class=\"arab\">مِكْوَاةٌ</span> : seterika","<span class=\"arab\">تِلْفَازٌ</span> : televisyen","<span class=\"arab\">غَسَّالَةٌ</span> : mesin basuh","<span class=\"arab\">مُكَيِّفٌ</span> : penghawa dingin","<span class=\"arab\">مِذْيَاعٌ</span> : radio","<span class=\"arab\">فُرْنٌ</span> : ketuhar"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">أَنَا أَغْسِلُ الْمَلَابِسَ بِالْغَسَّالَةِ</span> : Saya membasuh pakaian dengan mesin basuh.","<span class=\"arab\">فِي مَنْزِلِي مُكَيِّفٌ</span> : Di rumah saya ada penghawa dingin."]}],"glosari":[["Perabot","<span class=\"arab\">أَثَاثٌ</span>"],["Rumah","<span class=\"arab\">بَيْتٌ</span>"],["Elektrik","<span class=\"arab\">كَهْرَبَاءُ</span>"]]},{"id":"t3-arab-kafa-3","nama":"Peralatan dapur","nota":[{"j":"h","t":"Peralatan dapur"},{"j":"p","t":"Kita belajar nama peralatan dapur dalam bahasa Arab. <span class=\"arab\">الْمَطْبَخُ نَظِيفٌ</span> bermaksud dapur itu bersih."},{"j":"l","t":["<span class=\"arab\">صَحْنٌ</span> : pinggan","<span class=\"arab\">كُوبٌ</span> : cawan","<span class=\"arab\">فِنْجَانٌ</span> : cawan kopi","<span class=\"arab\">سِكِّينٌ</span> : pisau","<span class=\"arab\">شَوْكَةٌ</span> : garpu","<span class=\"arab\">مِلْعَقَةٌ</span> : sudu","<span class=\"arab\">قَدَحٌ</span> : gelas","<span class=\"arab\">إِبْرِيقٌ</span> : teko","<span class=\"arab\">مِغْرَفَةٌ</span> : senduk","<span class=\"arab\">قِدْرٌ</span> : periuk","<span class=\"arab\">مِقْلَاةٌ</span> : kuali","<span class=\"arab\">خَلَّاطَةٌ</span> : pengisar","<span class=\"arab\">عَصَّارَةٌ</span> : pemerah jus"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">يَأْخُذُ الْأَبُ الْأَطْعِمَةَ بِالْمِلْعَقَةِ</span> : Ayah mengambil makanan dengan sudu.","<span class=\"arab\">تَقْطَعُ الْأُمُّ الْخِيَارَ بِالسِّكِّينِ</span> : Ibu memotong timun dengan pisau."]}],"glosari":[["Dapur","<span class=\"arab\">مَطْبَخٌ</span>"],["Bersih","<span class=\"arab\">نَظِيفٌ</span>"]]},{"id":"t3-arab-kafa-4","nama":"Bulan hijrah dan masihi","nota":[{"j":"h","t":"Bulan hijrah"},{"j":"p","t":"Ada dua belas bulan dalam setahun. Bulan hijrah yang pertama ialah <span class=\"arab\">مُحَرَّمٌ</span>."},{"j":"l","t":["1. <span class=\"arab\">مُحَرَّمٌ</span>","2. <span class=\"arab\">صَفَرٌ</span>","3. <span class=\"arab\">رَبِيعُ الْأَوَّلِ</span>","4. <span class=\"arab\">رَبِيعُ الْآخِرِ</span>","5. <span class=\"arab\">جُمَادَى الْأُولَى</span>","6. <span class=\"arab\">جُمَادَى الْآخِرَةِ</span>","7. <span class=\"arab\">رَجَبٌ</span>","8. <span class=\"arab\">شَعْبَانُ</span>","9. <span class=\"arab\">رَمَضَانُ</span>","10. <span class=\"arab\">شَوَّالٌ</span>","11. <span class=\"arab\">ذُو الْقَعْدَةِ</span>","12. <span class=\"arab\">ذُو الْحِجَّةِ</span>"]},{"j":"h","t":"Bulan masihi"},{"j":"l","t":["<span class=\"arab\">يَنَايِرُ</span> : Januari","<span class=\"arab\">فِبْرَايِرُ</span> : Februari","<span class=\"arab\">مَارِسُ</span> : Mac","<span class=\"arab\">أَبْرِيلُ</span> : April","<span class=\"arab\">مَايُو</span> : Mei","<span class=\"arab\">يُونِيُو</span> : Jun","<span class=\"arab\">يُولِيُو</span> : Julai","<span class=\"arab\">أُغُسْطُسُ</span> : Ogos","<span class=\"arab\">سِبْتَمْبِرُ</span> : September","<span class=\"arab\">أُكْتُوبَرُ</span> : Oktober","<span class=\"arab\">نُوفَمْبِرُ</span> : November","<span class=\"arab\">دِيسَمْبِرُ</span> : Disember"]},{"j":"h","t":"Perayaan Islam"},{"j":"l","t":["<span class=\"arab\">رَبِيعُ الْأَوَّلِ</span>: Maulidur Rasul","<span class=\"arab\">رَجَبٌ</span>: Israk dan Mikraj","<span class=\"arab\">رَمَضَانُ</span>: bulan puasa","<span class=\"arab\">شَوَّالٌ</span>: Hari Raya Aidilfitri","<span class=\"arab\">ذُو الْحِجَّةِ</span>: Hari Raya Aidiladha"]}],"glosari":[["Bulan","<span class=\"arab\">شَهْرٌ</span>"],["Hijrah","Kalendar Islam yang bermula dengan hijrah Nabi Muhammad SAW."],["Masihi","Kalendar yang digunakan di seluruh dunia."]]},{"id":"t3-arab-kafa-5","nama":"Mudhakkar dan muannath","nota":[{"j":"h","t":"Pengertian"},{"j":"l","t":["{{Mudhakkar}} <span class=\"arab\">مُذَكَّرٌ</span>: kata nama untuk lelaki atau benda jantan","{{Muannath}} <span class=\"arab\">مُؤَنَّثٌ</span>: kata nama untuk perempuan, biasanya berakhir dengan <span class=\"arab\">ة</span>"]},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">مُدَرِّسٌ</span> / <span class=\"arab\">مُدَرِّسَةٌ</span> : guru lelaki / guru perempuan","<span class=\"arab\">طَبِيبٌ</span> / <span class=\"arab\">طَبِيبَةٌ</span> : doktor lelaki / doktor perempuan","<span class=\"arab\">بَائِعٌ</span> / <span class=\"arab\">بَائِعَةٌ</span> : penjual lelaki / perempuan","<span class=\"arab\">مُهَنْدِسٌ</span> / <span class=\"arab\">مُهَنْدِسَةٌ</span> : jurutera lelaki / perempuan"]},{"j":"h","t":"Benda"},{"j":"l","t":["<span class=\"arab\">بَيْتٌ، كِتَابٌ، بَابٌ</span> : mudhakkar","<span class=\"arab\">سَيَّارَةٌ، حَقِيبَةٌ، زَهْرَةٌ</span> : muannath"]},{"j":"h","t":"Ganti nama"},{"j":"l","t":["<span class=\"arab\">أَنْتَ</span> : kamu (lelaki)","<span class=\"arab\">أَنْتِ</span> : kamu (perempuan)","<span class=\"arab\">هُوَ</span> : dia (lelaki)","<span class=\"arab\">هِيَ</span> : dia (perempuan)"]}],"glosari":[["Mudhakkar","Kata nama lelaki."],["Muannath","Kata nama perempuan."],["Ta marbutah","Huruf <span class=\"arab\">ة</span> di akhir kata nama muannath."]]},{"id":"t3-arab-kafa-6","nama":"Ayat namaan","nota":[{"j":"h","t":"Al-jumlah al-ismiyyah"},{"j":"p","t":"{{Ayat namaan}} <span class=\"arab\">الْجُمْلَةُ الْاِسْمِيَّةُ</span> ialah ayat yang dimulakan dengan kata nama."},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">هٰذَا أَبِي</span> : Ini ayah saya.","<span class=\"arab\">هٰذِهِ أُمِّي</span> : Ini ibu saya.","<span class=\"arab\">السَّيَّارَةُ جَمِيلَةٌ</span> : Kereta itu cantik.","<span class=\"arab\">هُوَ إِمَامٌ</span> : Dia seorang imam.","<span class=\"arab\">زَيْنَبُ مُعَلِّمَةٌ</span> : Zainab seorang guru.","<span class=\"arab\">الْقِطَارُ سَرِيعٌ</span> : Kereta api itu laju."]},{"j":"h","t":"Kata tunjuk"},{"j":"l","t":["<span class=\"arab\">هٰذَا</span> : ini (lelaki)","<span class=\"arab\">هٰذِهِ</span> : ini (perempuan)","<span class=\"arab\">ذٰلِكَ</span> : itu (lelaki)","<span class=\"arab\">تِلْكَ</span> : itu (perempuan)"]}],"glosari":[["Ayat namaan","Ayat yang dimulakan dengan kata nama."],["Kata tunjuk","Perkataan untuk menunjuk, seperti ini dan itu."]]},{"id":"t3-arab-kafa-7","nama":"Mufrad, muthanna dan jamak","nota":[{"j":"h","t":"Bilangan kata nama"},{"j":"l","t":["{{Mufrad}} <span class=\"arab\">مُفْرَدٌ</span>: satu","{{Muthanna}} <span class=\"arab\">مُثَنًّى</span>: dua — ditambah <span class=\"arab\">انِ</span> di akhir","{{Jamak}} <span class=\"arab\">جَمْعٌ</span>: tiga atau lebih"]},{"j":"h","t":"Jamak lelaki"},{"j":"p","t":"Ditambah <span class=\"arab\">ونَ</span>: <span class=\"arab\">مُسْلِمٌ، مُسْلِمَانِ، مُسْلِمُونَ</span>"},{"j":"h","t":"Jamak perempuan"},{"j":"p","t":"Ditambah <span class=\"arab\">اتٌ</span>: <span class=\"arab\">مُعَلِّمَةٌ، مُعَلِّمَتَانِ، مُعَلِّمَاتٌ</span>"},{"j":"h","t":"Jamak benda"},{"j":"l","t":["<span class=\"arab\">بَيْتٌ ← بُيُوتٌ</span> : rumah","<span class=\"arab\">كِتَابٌ ← كُتُبٌ</span> : buku","<span class=\"arab\">بَابٌ ← أَبْوَابٌ</span> : pintu","<span class=\"arab\">نَجْمٌ ← نُجُومٌ</span> : bintang","<span class=\"arab\">سَاعَةٌ ← سَاعَاتٌ</span> : jam","<span class=\"arab\">سَفِينَةٌ ← سُفُنٌ</span> : kapal"]}],"glosari":[["Mufrad","Satu."],["Muthanna","Dua."],["Jamak","Tiga atau lebih."]]},{"id":"t3-arab-kafa-8","nama":"Di sekolah","nota":[{"j":"h","t":"Di sekolah"},{"j":"p","t":"Kita belajar nama tempat di sekolah dalam bahasa Arab. <span class=\"arab\">كُنْ تِلْمِيذًا مِثَالِيًّا</span> bermaksud jadilah murid yang contoh."},{"j":"l","t":["<span class=\"arab\">مُصَلًّى</span> : surau","<span class=\"arab\">مَكْتَبَةٌ</span> : perpustakaan","<span class=\"arab\">غُرْفَةُ الْمُعَلِّمِينَ</span> : bilik guru","<span class=\"arab\">مَرْأَبُ السَّيَّارَةِ</span> : tempat letak kereta","<span class=\"arab\">قَاعَةٌ</span> : dewan","<span class=\"arab\">مَطْعَمٌ</span> : kantin","<span class=\"arab\">إِدَارَةٌ</span> : pejabat","<span class=\"arab\">مَخْزَنٌ</span> : stor","<span class=\"arab\">غُرْفَةُ الْمُدِيرِ</span> : bilik guru besar","<span class=\"arab\">مَعْمَلُ الْحَاسُوبِ</span> : makmal komputer","<span class=\"arab\">دَوْرَةُ الْمِيَاهِ</span> : tandas","<span class=\"arab\">سَاحَةُ الْمَدْرَسَةِ</span> : padang sekolah"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">الْمُدَرِّسُ فِي الْمَكْتَبَةِ</span> : Guru di perpustakaan.","<span class=\"arab\">التِّلْمِيذُ فِي الْقَاعَةِ</span> : Murid di dewan.","<span class=\"arab\">أَيْنَ؟</span> : di mana?"]}],"glosari":[["Sekolah","<span class=\"arab\">مَدْرَسَةٌ</span>"],["Di mana","<span class=\"arab\">أَيْنَ</span>"]]},{"id":"t3-arab-kafa-9","nama":"Di bandar","nota":[{"j":"h","t":"Di bandar"},{"j":"p","t":"Kita belajar nama tempat di bandar dalam bahasa Arab. <span class=\"arab\">الْمَدِينَةُ رَائِعَةٌ</span> bermaksud bandar itu menarik."},{"j":"l","t":["<span class=\"arab\">مُسْتَشْفًى</span> : hospital","<span class=\"arab\">فُنْدُقٌ</span> : hotel","<span class=\"arab\">مَرْكَزُ الْإِطْفَاءِ</span> : balai bomba","<span class=\"arab\">مَرْكَزُ الشُّرْطَةِ</span> : balai polis","<span class=\"arab\">مَصْنَعٌ</span> : kilang","<span class=\"arab\">السُّوقُ الْمَرْكَزِيُّ</span> : pasar raya","<span class=\"arab\">بَنْكٌ</span> : bank","<span class=\"arab\">مَكْتَبُ الْبَرِيدِ</span> : pejabat pos","<span class=\"arab\">مَطَارٌ</span> : lapangan terbang","<span class=\"arab\">مَحَطَّةُ الْحَافِلَةِ</span> : stesen bas","<span class=\"arab\">مَحَطَّةُ الْقِطَارِ</span> : stesen kereta api","<span class=\"arab\">مَحَطَّةُ سَيَّارَةِ الْأُجْرَةِ</span> : stesen teksi"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">الطَّبِيبُ يَعْمَلُ فِي الْمُسْتَشْفَى</span> : Doktor bekerja di hospital.","<span class=\"arab\">الشُّرْطِيُّ يَعْمَلُ فِي مَرْكَزِ الشُّرْطَةِ</span> : Polis bekerja di balai polis.","<span class=\"arab\">الْفُنْدُقُ مَشْهُورٌ</span> : Hotel itu terkenal."]}],"glosari":[["Bandar","<span class=\"arab\">مَدِينَةٌ</span>"],["Terkenal","<span class=\"arab\">مَشْهُورٌ</span>"],["Stesen","<span class=\"arab\">مَحَطَّةٌ</span>"]]},{"id":"t3-arab-kafa-10","nama":"Ulang kaji bahasa Arab Tahun 3","nota":[{"j":"h","t":"Ringkasan"},{"j":"l","t":["Nombor: <span class=\"arab\">مِائَتَانِ</span> dua ratus, <span class=\"arab\">ثَلَاثُمِائَةٍ</span> tiga ratus","Bulan hijrah pertama: <span class=\"arab\">مُحَرَّمٌ</span>","Muannath berakhir dengan <span class=\"arab\">ة</span>","Muthanna ditambah <span class=\"arab\">انِ</span>, jamak lelaki <span class=\"arab\">ونَ</span>, jamak perempuan <span class=\"arab\">اتٌ</span>"]}],"glosari":[["Bahasa Arab","Bahasa al-Quran."]]}]}