{"id":"t5-arab-kafa","tahap":"T5","nama":"Bahasa Arab (KAFA)","sk":"Bahasa Arab","ikon":"🕌","warna":"#C0703A","bahasa":"ms","kur":"KAFA Tahun 5 (ikut e-buku Bahasa Arab Tahun 5)","semak":"pending teacher review","jawi":true,"versi":"0.5.68","sumber":"Original notes and questions following the 13 lessons of the owner's e-BOOK BAHASA ARAB Tahun 5 (JAIS); shown in full Jawi.","topik":[{"id":"t5-arab-kafa-1","nama":"Nombor 401 hingga 500","nota":[{"j":"h","t":"Nombor"},{"j":"p","t":"<span class=\"arab\">أَرْبَعُمِائَةٍ</span> bermaksud empat ratus dan <span class=\"arab\">خَمْسُمِائَةٍ</span> bermaksud lima ratus."},{"j":"l","t":["<span class=\"arab\">أَرْبَعُمِائَةٍ وَوَاحِدٌ</span> : 401","<span class=\"arab\">أَرْبَعُمِائَةٍ وَعَشَرَةٌ</span> : 410","<span class=\"arab\">أَرْبَعُمِائَةٍ وَعِشْرُونَ</span> : 420","<span class=\"arab\">أَرْبَعُمِائَةٍ وَخَمْسُونَ</span> : 450","<span class=\"arab\">أَرْبَعُمِائَةٍ وَتِسْعُونَ</span> : 490","<span class=\"arab\">خَمْسُمِائَةٍ</span> : 500"]}],"glosari":[["Empat ratus","<span class=\"arab\">أَرْبَعُمِائَةٍ</span>"],["Lima ratus","<span class=\"arab\">خَمْسُمِائَةٍ</span>"]]},{"id":"t5-arab-kafa-2","nama":"Kata ganti nama","nota":[{"j":"h","t":"Ad-dama'ir"},{"j":"l","t":["<span class=\"arab\">أَنَا</span> : saya","<span class=\"arab\">نَحْنُ</span> : kami","<span class=\"arab\">أَنْتَ</span> : kamu (lelaki)","<span class=\"arab\">أَنْتِ</span> : kamu (perempuan)","<span class=\"arab\">أَنْتُمَا</span> : kamu berdua","<span class=\"arab\">أَنْتُمْ</span> : kamu semua (lelaki)","<span class=\"arab\">أَنْتُنَّ</span> : kamu semua (perempuan)","<span class=\"arab\">هُوَ</span> : dia (lelaki)","<span class=\"arab\">هِيَ</span> : dia (perempuan)","<span class=\"arab\">هُمَا</span> : mereka berdua","<span class=\"arab\">هُمْ</span> : mereka (lelaki)","<span class=\"arab\">هُنَّ</span> : mereka (perempuan)"]},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">أَنَا تِلْمِيذٌ</span> : Saya murid.","<span class=\"arab\">هِيَ مُعَلِّمَةٌ</span> : Dia seorang guru perempuan.","<span class=\"arab\">نَحْنُ مُسْلِمُونَ</span> : Kami orang Islam."]}],"glosari":[["Kata ganti nama","<span class=\"arab\">ضَمِيرٌ</span>"],["Saya","<span class=\"arab\">أَنَا</span>"],["Kami","<span class=\"arab\">نَحْنُ</span>"]]},{"id":"t5-arab-kafa-3","nama":"Ke pantai","nota":[{"j":"h","t":"Ke pantai"},{"j":"p","t":"Kita belajar perkataan tentang lawatan ke pantai. <span class=\"arab\">الرِّحْلَةُ إِلَى شَاطِئِ الْبَحْرِ</span> bermaksud lawatan ke pantai."},{"j":"l","t":["<span class=\"arab\">شَاطِئٌ</span> : pantai","<span class=\"arab\">بَحْرٌ</span> : laut","<span class=\"arab\">رَمْلٌ</span> : pasir","<span class=\"arab\">مَوْجٌ</span> : ombak","<span class=\"arab\">صَدَفٌ</span> : kulit kerang","<span class=\"arab\">قَارِبٌ</span> : bot","<span class=\"arab\">شَمْسٌ</span> : matahari","<span class=\"arab\">سِبَاحَةٌ</span> : berenang","<span class=\"arab\">صَيَّادٌ</span> : nelayan","<span class=\"arab\">سَمَكٌ</span> : ikan"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">نَسْبَحُ فِي الْبَحْرِ</span> : Kami berenang di laut.","<span class=\"arab\">نَجْمَعُ الصَّدَفَ عَلَى الرَّمْلِ</span> : Kami mengumpul kulit kerang di atas pasir."]}],"glosari":[["Lawatan","<span class=\"arab\">رِحْلَةٌ</span>"],["Pantai","<span class=\"arab\">شَاطِئٌ</span>"]]},{"id":"t5-arab-kafa-4","nama":"Burung dan serangga","nota":[{"j":"h","t":"Burung dan serangga"},{"j":"p","t":"Kita belajar nama burung dan serangga dalam bahasa Arab. <span class=\"arab\">الطُّيُورُ وَالْحَشَرَاتُ</span> bermaksud burung dan serangga."},{"j":"l","t":["<span class=\"arab\">حَمَامَةٌ</span> : merpati","<span class=\"arab\">عُصْفُورٌ</span> : burung pipit","<span class=\"arab\">غُرَابٌ</span> : gagak","<span class=\"arab\">صَقْرٌ</span> : helang","<span class=\"arab\">بَبَّغَاءُ</span> : burung kakak tua","<span class=\"arab\">دِيكٌ</span> : ayam jantan","<span class=\"arab\">نَحْلَةٌ</span> : lebah","<span class=\"arab\">نَمْلَةٌ</span> : semut","<span class=\"arab\">فَرَاشَةٌ</span> : rama-rama","<span class=\"arab\">بَعُوضَةٌ</span> : nyamuk","<span class=\"arab\">ذُبَابَةٌ</span> : lalat","<span class=\"arab\">عَنْكَبُوتٌ</span> : labah-labah"]},{"j":"h","t":"Tahukah anda?"},{"j":"l","t":["Ada surah bernama <span class=\"arab\">النَّحْلُ</span> (lebah), <span class=\"arab\">النَّمْلُ</span> (semut) dan <span class=\"arab\">الْعَنْكَبُوتُ</span> (labah-labah)"]}],"glosari":[["Burung","<span class=\"arab\">طَيْرٌ</span>"],["Serangga","<span class=\"arab\">حَشَرَةٌ</span>"]]},{"id":"t5-arab-kafa-5","nama":"Alat komunikasi moden","nota":[{"j":"h","t":"Alat komunikasi moden"},{"j":"p","t":"Kita belajar nama alat komunikasi moden. <span class=\"arab\">الْأَدَوَاتُ الْاِتِّصَالِيَّةُ الْحَدِيثَةُ</span> bermaksud alat komunikasi moden."},{"j":"l","t":["<span class=\"arab\">هَاتِفٌ</span> : telefon","<span class=\"arab\">هَاتِفٌ مَحْمُولٌ</span> : telefon bimbit","<span class=\"arab\">حَاسُوبٌ</span> : komputer","<span class=\"arab\">حَاسُوبٌ مَحْمُولٌ</span> : komputer riba","<span class=\"arab\">طَابِعَةٌ</span> : pencetak","<span class=\"arab\">رِسَالَةٌ</span> : surat","<span class=\"arab\">بَرِيدٌ إِلِكْتُرُونِيٌّ</span> : e-mel","<span class=\"arab\">شَبَكَةٌ</span> : internet","<span class=\"arab\">تِلْفَازٌ</span> : televisyen","<span class=\"arab\">مِذْيَاعٌ</span> : radio"]},{"j":"h","t":"Ingat"},{"j":"p","t":"Kita menggunakan alat komunikasi untuk perkara yang berfaedah dan tidak menyebarkan berita palsu."}],"glosari":[["Komunikasi","<span class=\"arab\">اِتِّصَالٌ</span>"],["Moden","<span class=\"arab\">حَدِيثٌ</span>"]]},{"id":"t5-arab-kafa-6","nama":"Ke zoo","nota":[{"j":"h","t":"Ke zoo"},{"j":"p","t":"Kita belajar nama haiwan di zoo. <span class=\"arab\">حَدِيقَةُ الْحَيَوَانَاتِ</span> bermaksud zoo."},{"j":"l","t":["<span class=\"arab\">أَسَدٌ</span> : singa","<span class=\"arab\">نَمِرٌ</span> : harimau","<span class=\"arab\">فِيلٌ</span> : gajah","<span class=\"arab\">زَرَافَةٌ</span> : zirafah","<span class=\"arab\">قِرْدٌ</span> : monyet","<span class=\"arab\">دُبٌّ</span> : beruang","<span class=\"arab\">حِمَارُ الْوَحْشِ</span> : kuda belang","<span class=\"arab\">تِمْسَاحٌ</span> : buaya","<span class=\"arab\">ثُعْبَانٌ</span> : ular","<span class=\"arab\">جَمَلٌ</span> : unta"]},{"j":"h","t":"Contoh ayat"},{"j":"l","t":["<span class=\"arab\">الزَّرَافَةُ طَوِيلَةٌ</span> : Zirafah itu tinggi.","<span class=\"arab\">الْفِيلُ كَبِيرٌ</span> : Gajah itu besar."]}],"glosari":[["Zoo","<span class=\"arab\">حَدِيقَةُ الْحَيَوَانَاتِ</span>"],["Haiwan","<span class=\"arab\">حَيَوَانٌ</span>"]]},{"id":"t5-arab-kafa-7","nama":"Huruf nafi dan la nahiyah","nota":[{"j":"h","t":"Huruf nafi (penafian)"},{"j":"l","t":["<span class=\"arab\">لَا</span> : tidak (kini), <span class=\"arab\">لَا أَذْهَبُ</span> saya tidak pergi","<span class=\"arab\">مَا</span> : tidak (lampau), <span class=\"arab\">مَا ذَهَبْتُ</span> saya tidak pergi","<span class=\"arab\">لَمْ</span> : tidak (lampau), <span class=\"arab\">لَمْ أَذْهَبْ</span> saya tidak pergi","<span class=\"arab\">لَنْ</span> : tidak akan, <span class=\"arab\">لَنْ أَذْهَبَ</span> saya tidak akan pergi"]},{"j":"h","t":"La nahiyah (larangan)"},{"j":"p","t":"<span class=\"arab\">لَا</span> yang bermaksud jangan, diikuti fi'il mudari' yang dimatikan: <span class=\"arab\">لَا تَكْذِبْ</span> (jangan berbohong), <span class=\"arab\">لَا تَلْعَبْ</span> (jangan bermain)."}],"glosari":[["Nafi","Penafian."],["Nahiyah","Larangan."]]},{"id":"t5-arab-kafa-8","nama":"Huruf jar","nota":[{"j":"h","t":"Huruf jar"},{"j":"p","t":"{{Huruf jar}} menjadikan kata nama selepasnya berbaris di bawah (majrur)."},{"j":"l","t":["<span class=\"arab\">مِنْ</span> : dari","<span class=\"arab\">إِلَى</span> : ke","<span class=\"arab\">فِي</span> : di dalam","<span class=\"arab\">عَلَى</span> : di atas","<span class=\"arab\">عَنْ</span> : tentang","<span class=\"arab\">بِـ</span> : dengan","<span class=\"arab\">لِـ</span> : untuk","<span class=\"arab\">كَـ</span> : seperti"]},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">ذَهَبْتُ إِلَى الْمَدْرَسَةِ</span> : Saya pergi ke sekolah.","<span class=\"arab\">الْكِتَابُ عَلَى الْمَكْتَبِ</span> : Buku di atas meja.","<span class=\"arab\">رَجَعَ مِنَ السُّوقِ</span> : Dia pulang dari pasar."]}],"glosari":[["Huruf jar","Kata sendi yang membariskan bawah kata nama selepasnya."],["Majrur","Berbaris di bawah."]]},{"id":"t5-arab-kafa-9","nama":"Melawat hospital","nota":[{"j":"h","t":"Melawat hospital"},{"j":"p","t":"Kita belajar perkataan ketika melawat orang sakit di hospital. Kita mendoakan pesakit: <span class=\"arab\">شَفَاكَ اللّٰهُ</span>."},{"j":"l","t":["<span class=\"arab\">مُسْتَشْفًى</span> : hospital","<span class=\"arab\">مَرِيضٌ</span> : pesakit","<span class=\"arab\">طَبِيبٌ</span> : doktor","<span class=\"arab\">مُمَرِّضَةٌ</span> : jururawat","<span class=\"arab\">دَوَاءٌ</span> : ubat","<span class=\"arab\">صَيْدَلِيَّةٌ</span> : farmasi","<span class=\"arab\">سَرِيرٌ</span> : katil","<span class=\"arab\">حُمَّى</span> : demam"]},{"j":"h","t":"Doa"},{"j":"p","t":"<span class=\"arab\">لَا بَأْسَ طَهُورٌ إِنْ شَاءَ اللّٰهُ</span>"}],"glosari":[["Sakit","<span class=\"arab\">مَرَضٌ</span>"],["Ubat","<span class=\"arab\">دَوَاءٌ</span>"]]},{"id":"t5-arab-kafa-10","nama":"Al-fa'il","nota":[{"j":"h","t":"Pengertian"},{"j":"p","t":"{{Al-fa'il}} ialah pelaku perbuatan dalam ayat kerja. Ia datang selepas fi'il dan berbaris di hadapan (marfu')."},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">كَتَبَ مُحَمَّدٌ الدَّرْسَ</span> : Muhammad menulis pelajaran. (fa'il: <span class=\"arab\">مُحَمَّدٌ</span>)","<span class=\"arab\">ذَهَبَتْ فَاطِمَةُ</span> : Fatimah pergi. (fa'il: <span class=\"arab\">فَاطِمَةُ</span>)","<span class=\"arab\">نَجَحَ التِّلْمِيذُ</span> : Murid itu berjaya."]}],"glosari":[["Fa'il","Pelaku perbuatan."],["Marfu'","Berbaris di hadapan."]]},{"id":"t5-arab-kafa-11","nama":"Al-maf'ul bihi","nota":[{"j":"h","t":"Pengertian"},{"j":"p","t":"{{Al-maf'ul bihi}} ialah objek yang menerima perbuatan. Ia berbaris di atas (mansub)."},{"j":"h","t":"Contoh"},{"j":"l","t":["<span class=\"arab\">قَرَأَ أَحْمَدُ الْقُرْآنَ</span> : Ahmad membaca al-Quran. (maf'ul bihi: <span class=\"arab\">الْقُرْآنَ</span>)","<span class=\"arab\">شَرِبَ الْوَلَدُ الْحَلِيبَ</span> : Budak itu minum susu.","<span class=\"arab\">فَتَحَتْ زَيْنَبُ الْبَابَ</span> : Zainab membuka pintu."]}],"glosari":[["Maf'ul bihi","Objek yang menerima perbuatan."],["Mansub","Berbaris di atas."]]},{"id":"t5-arab-kafa-12","nama":"Fi'il thulathi mazid satu huruf","nota":[{"j":"h","t":"Pengertian"},{"j":"p","t":"{{Fi'il thulathi}} ialah kata kerja tiga huruf asal. {{Mazid}} bermaksud ditambah satu huruf."},{"j":"h","t":"Wazan"},{"j":"l","t":["<span class=\"arab\">أَفْعَلَ</span> : ditambah hamzah, <span class=\"arab\">أَكْرَمَ</span> (memuliakan)","<span class=\"arab\">فَعَّلَ</span> : digandakan huruf tengah, <span class=\"arab\">عَلَّمَ</span> (mengajar)","<span class=\"arab\">فَاعَلَ</span> : ditambah alif, <span class=\"arab\">سَاعَدَ</span> (membantu)"]}],"glosari":[["Thulathi","Tiga huruf asal."],["Mazid","Ditambah."],["Wazan","Timbangan atau pola perkataan."]]},{"id":"t5-arab-kafa-13","nama":"Ke kedai","nota":[{"j":"h","t":"Ke kedai"},{"j":"p","t":"Kita belajar perkataan ketika membeli-belah. <span class=\"arab\">الْمَحَلَّاتُ التِّجَارِيَّةُ</span> bermaksud kedai-kedai."},{"j":"l","t":["<span class=\"arab\">دُكَّانٌ</span> : kedai","<span class=\"arab\">بَائِعٌ</span> : penjual","<span class=\"arab\">مُشْتَرٍ</span> : pembeli","<span class=\"arab\">سِعْرٌ</span> : harga","<span class=\"arab\">رَخِيصٌ</span> : murah","<span class=\"arab\">غَالٍ</span> : mahal","<span class=\"arab\">نُقُودٌ</span> : wang","<span class=\"arab\">مَخْبَزٌ</span> : kedai roti"]},{"j":"h","t":"Perbualan"},{"j":"l","t":["<span class=\"arab\">بِكَمْ هٰذَا؟</span> : Berapa harga ini?","<span class=\"arab\">هٰذَا رَخِيصٌ</span> : Ini murah.","<span class=\"arab\">شُكْرًا</span> : terima kasih"]}],"glosari":[["Kedai","<span class=\"arab\">دُكَّانٌ</span>"],["Wang","<span class=\"arab\">نُقُودٌ</span>"]]},{"id":"t5-arab-kafa-14","nama":"Ulang kaji bahasa Arab Tahun 5","nota":[{"j":"h","t":"Ringkasan"},{"j":"l","t":["Nombor hingga <span class=\"arab\">خَمْسُمِائَةٍ</span>","Kata ganti nama: <span class=\"arab\">أَنَا، نَحْنُ، هُوَ، هِيَ</span>","Huruf jar: <span class=\"arab\">مِنْ، إِلَى، فِي، عَلَى</span>","Fa'il berbaris di hadapan, maf'ul bihi berbaris di atas"]}],"glosari":[["Bahasa Arab","Bahasa al-Quran."]]}]}