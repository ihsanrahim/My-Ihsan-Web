j":"h","t":"Kenderaan"},{"j":"c","t":"سَيَّارَةٌ = kereta · حَافِلَةٌ = bas · طَائِرَةٌ = kapal terbang"},{"j":"p","t":"Untuk menyebut <i>dengan (kenderaan)</i>, gunakan huruf <b>بِـ</b>: بِالْحَافِلَةِ = dengan bas."},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["سَيَّارَةٌ","🚗 kereta"],["دَرَّاجَةٌ","🚲 basikal"],["دَرَّاجَةٌ نَارِيَّةٌ","🏍️ motosikal"],["حَافِلَةٌ","🚌 bas"],["طَائِرَةٌ","✈️ kapal terbang"],["قِطَارٌ","🚆 kereta api"],["سَفِينَةٌ","🚢 kapal"],["قَارِبٌ","⛵ perahu"],["شَاحِنَةٌ","🚚 lori"],["سَيَّارَةُ أُجْرَةٍ","🚕 teksi"],["سَيَّارَةُ إِسْعَافٍ","🚑 ambulans"],["مِرْوَحِيَّةٌ","🚁 helikopter"]]},{"j":"h","t":"Ayat contoh"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["أَذْهَبُ إِلَى الْمَدْرَسَةِ بِالْحَافِلَةِ.","Saya pergi ke sekolah dengan bas."],["أَذْهَبُ إِلَى الْمَدْرَسَةِ بِالسَّيَّارَةِ.","Saya pergi ke sekolah dengan kereta."],["أَذْهَبُ إِلَى الْمَدْرَسَةِ بِالدَّرَّاجَةِ.","Saya pergi ke sekolah dengan basikal."],["أَذْهَبُ إِلَى السُّوقِ بِالسَّيَّارَةِ.","Saya pergi ke pasar dengan kereta."],["أَذْهَبُ إِلَى الْمَسْجِدِ مَاشِيًا.","Saya pergi ke masjid dengan berjalan kaki."],["هٰذِهِ سَيَّارَةُ أَبِي.","Ini kereta bapa saya."]]}],"glosari":[]},{"id":"t3-arab-4","nama":"الْأَيَّامُ وَالْأَوْقَاتُ · Hari & Waktu 📅","nota":[{"j":"h","t":"Hari dalam seminggu"},{"j":"p","t":"Seminggu ada tujuh hari. Minggu bermula dengan يَوْمُ الْأَحَدِ (Ahad)."},{"j":"c","t":"الْيَوْمَ = hari ini · غَدًا = esok · أَمْسِ = semalam"},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["يَوْمُ الْأَحَدِ","hari Ahad"],["يَوْمُ الْاِثْنَيْنِ","hari Isnin"],["يَوْمُ الثُّلَاثَاءِ","hari Selasa"],["يَوْمُ الْأَرْبِعَاءِ","hari Rabu"],["يَوْمُ الْخَمِيسِ","hari Khamis"],["يَوْمُ الْجُمُعَةِ","hari Jumaat"],["يَوْمُ السَّبْتِ","hari Sabtu"],["صَبَاحٌ","🌅 pagi"],["ظُهْرٌ","☀️ tengah hari"],["مَسَاءٌ","🌇 petang"],["لَيْلٌ","🌙 malam"],["نَهَارٌ","siang"],["الْيَوْمَ","hari ini"],["غَدًا","esok"],["أَمْسِ","semalam"],["أُسْبُوعٌ","minggu"],["شَهْرٌ","📅 bulan (kalendar)"],["سَنَةٌ","tahun"]]}],"glosari":[]},{"id":"t3-arab-5","nama":"الْأَفْعَالُ الْيَوْمِيَّةُ · Kata Kerja Harian 🏃","nota":[{"j":"h","t":"Apa yang saya buat?"},{"j":"p","t":"Kata kerja yang bermula dengan <b>أَ</b> bermaksud <i>saya</i> sedang melakukannya."},{"j":"c","t":"أَقْرَأُ الْكِتَابَ. = Saya membaca buku. · أَشْرَبُ الْمَاءَ. = Saya minum air."},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["أَقْرَأُ","📖 saya membaca"],["أَكْتُبُ","✏️ saya menulis"],["آكُلُ","🍽️ saya makan"],["أَشْرَبُ","🥤 saya minum"],["أَجْلِسُ","🪑 saya duduk"],["أَقِفُ","🧍 saya berdiri"],["أَذْهَبُ","saya pergi"],["أَنَامُ","😴 saya tidur"],["أَلْعَبُ","⚽ saya bermain"],["أَسْتَيْقِظُ","⏰ saya bangun tidur"],["أُصَلِّي","🕌 saya solat"],["أَتَوَضَّأُ","💧 saya berwuduk"],["أَغْسِلُ","saya membasuh"],["أَفْتَحُ","saya membuka"],["أَسْمَعُ","👂 saya mendengar"],["أَنْظُرُ","👀 saya melihat"],["أَرْسُمُ","🎨 saya melukis"],["أَدْرُسُ","saya belajar"]]}],"glosari":[["fi'il","Kata kerja dalam bahasa Arab."]]},{"id":"t3-arab-6","nama":"الصِّفَاتُ · Kata Sifat 🔤","nota":[{"j":"h","t":"Kata sifat dan lawannya"},{"j":"t","kepala":["Sifat","Lawannya"],"baris":[["كَبِيرٌ (besar)","صَغِيرٌ (kecil)"],["طَوِيلٌ (panjang)","قَصِيرٌ (pendek)"],["جَدِيدٌ (baharu)","قَدِيمٌ (lama)"],["نَظِيفٌ (bersih)","وَسِخٌ (kotor)"],["حَارٌّ (panas)","بَارِدٌ (sejuk)"]]},{"j":"c","t":"بَيْتٌ كَبِيرٌ = rumah yang besar. Dalam bahasa Arab, kata sifat datang <b>selepas</b> kata nama."},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["كَبِيرٌ","besar"],["صَغِيرٌ","kecil"],["طَوِيلٌ","panjang"],["قَصِيرٌ","pendek"],["جَدِيدٌ","baharu"],["قَدِيمٌ","lama"],["جَمِيلٌ","cantik"],["نَظِيفٌ","bersih"],["وَسِخٌ","kotor"],["حَارٌّ","panas"],["بَارِدٌ","sejuk"],["سَرِيعٌ","laju"],["بَطِيءٌ","perlahan"],["كَثِيرٌ","banyak"],["قَلِيلٌ","sedikit"],["سَعِيدٌ","gembira"],["حَزِينٌ","sedih"],["قَوِيٌّ","kuat"]]}],"glosari":[]},{"id":"t3-arab-7","nama":"أَيْنَ؟ · Kata Sendi & Arah 📍","nota":[{"j":"h","t":"Di mana?"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["فِي","di dalam"],["عَلَى","di atas"],["تَحْتَ","di bawah"],["أَمَامَ","di hadapan"],["خَلْفَ","di belakang"]]},{"j":"c","t":"الْكِتَابُ عَلَى الْمَكْتَبِ. = Buku itu di atas meja."},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["فِي","di dalam"],["عَلَى","di atas"],["تَحْتَ","di bawah"],["أَمَامَ","di hadapan"],["خَلْفَ","di belakang"],["بِجَانِبِ","di sebelah"],["بَيْنَ","di antara"],["مِنْ","dari"],["إِلَى","ke"],["مَعَ","bersama"],["أَيْنَ","di mana"],["هُنَا","di sini"],["هُنَاكَ","di sana"],["يَمِينٌ","➡️ kanan"],["يَسَارٌ","⬅️ kiri"]]},{"j":"h","t":"Ayat contoh"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["الْكِتَابُ عَلَى الْمَكْتَبِ.","Buku itu di atas meja."],["الْقِطُّ تَحْتَ الْكُرْسِيِّ.","Kucing itu di bawah kerusi."],["الْقَلَمُ فِي الْحَقِيبَةِ.","Pen itu di dalam beg."],["الْمُعَلِّمُ أَمَامَ الْفَصْلِ.","Guru itu di hadapan kelas."],["الْحَدِيقَةُ خَلْفَ الْبَيْتِ.","Taman itu di belakang rumah."],["أَيْنَ الْكِتَابُ؟","Di manakah buku itu?"],["الْمَسْجِدُ بِجَانِبِ الْمَدْرَسَةِ.","Masjid itu di sebelah sekolah."],["أَنَا مَعَ أَبِي.","Saya bersama bapa saya."]]}],"glosari":[]},{"id":"t3-arab-8","nama":"الطَّبِيعَةُ · Alam Semula Jadi 🌍","nota":[{"j":"h","t":"Alam ciptaan Allah"},{"j":"p","t":"Allah menciptakan langit, bumi dan segala isinya."},{"j":"c","t":"شَمْسٌ = matahari · قَمَرٌ = bulan · بَحْرٌ = laut"},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["شَمْسٌ","☀️ matahari"],["قَمَرٌ","🌙 bulan"],["نَجْمٌ","⭐ bintang"],["سَمَاءٌ","langit"],["أَرْضٌ","🌍 bumi"],["بَحْرٌ","🌊 laut"],["نَهْرٌ","sungai"],["جَبَلٌ","⛰️ gunung"],["شَجَرَةٌ","🌳 pokok"],["زَهْرَةٌ","🌸 bunga"],["مَطَرٌ","🌧️ hujan"],["سَحَابٌ","☁️ awan"],["رِيحٌ","🌬️ angin"],["غَابَةٌ","hutan"],["رَمْلٌ","pasir"],["حَجَرٌ","🪨 batu"],["نَارٌ","🔥 api"],["ثَلْجٌ","❄️ salji"]]}],"glosari":[]}]}