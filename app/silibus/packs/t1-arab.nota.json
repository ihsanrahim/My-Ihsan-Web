":"الْحَيَوَانَاتُ · Haiwan 🐾","nota":[{"j":"h","t":"Haiwan"},{"j":"p","t":"Allah menciptakan pelbagai jenis haiwan. Sebut nama haiwan dalam bahasa Arab."},{"j":"c","t":"قِطٌّ = kucing · سَمَكٌ = ikan · جَمَلٌ = unta"},{"j":"h","t":"Kosa kata"},{"j":"t","kepala":["Arab","Maksud"],"baris":[["قِطٌّ","🐱 kucing"],["أَرْنَبٌ","🐇 arnab"],["بَقَرَةٌ","🐄 lembu"],["دَجَاجَةٌ","🐔 ayam"],["سَمَكٌ","🐟 ikan"],["طَائِرٌ","🐦 burung"],["فِيلٌ","🐘 gajah"],["أَسَدٌ","🦁 singa"],["نَمِرٌ","🐯 harimau"],["قِرْدٌ","🐒 monyet"],["حِصَانٌ","🐴 kuda"],["جَمَلٌ","🐫 unta"],["خَرُوفٌ","🐑 biri-biri"],["بَطَّةٌ","🦆 itik"],["نَمْلَةٌ","🐜 semut"],["نَحْلَةٌ","🐝 lebah"],["فَأْرٌ","🐭 tikus"],["ثُعْبَانٌ","🐍 ular"],["سُلَحْفَاةٌ","🐢 kura-kura"],["فَرَاشَةٌ","🦋 rama-rama"]]}],"glosari":[]}]}