{"id":"t3-hafazan","tahap":"T3","nama":"Hafazan (KAFA)","sk":"Hafazan","ikon":"📖","warna":"#7A5AB8","bahasa":"ms","kur":"KAFA Tahun 3 (hafazan Juz 'Amma)","semak":"pending ustaz review","jawi":true,"versi":"0.5.67","sumber":"Year 3 hafazan surahs; Quran text from the app's KFGQPC Uthmani data; meanings are short summaries pending an ustaz's review; shown in full Jawi.","topik":[{"id":"t3-hafazan-1","nama":"Surah Al-Bayyinah","soalan":[{"j":"mcq","s":"Surah Al-Bayyinah mempunyai ______ ayat.","p":["lapan","enam","tujuh","sembilan"],"a":"lapan","aras":1,"id":"t3-hafazan-1.31e9a4"},{"j":"mcq","s":"Surah Al-Bayyinah ialah surah ______.","p":["Madaniyyah","Makkiyyah"],"a":"Madaniyyah","aras":1,"id":"t3-hafazan-1.a7b141"},{"j":"mcq","s":"Maksud nama Surah Al-Bayyinah ialah ______.","p":["Bukti yang nyata","Melapangkan","Waktu dhuha","Malam"],"a":"Bukti yang nyata","aras":1,"id":"t3-hafazan-1.5d7611"},{"j":"mcq","s":"Ayat pertama Surah Al-Bayyinah ialah ______.","p":["<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>","<span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>"],"a":"<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","aras":2,"id":"t3-hafazan-1.07a26b"},{"j":"isi","s":"Surah Al-Bayyinah ialah surah yang ke-98 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-1.af4cc9"},{"j":"bs","s":"Surah Al-Bayyinah ialah surah Madaniyyah.","a":"Betul","aras":1,"id":"t3-hafazan-1.9a0927"},{"j":"bs","s":"Surah Al-Bayyinah mempunyai sembilan ayat.","a":"Salah","aras":1,"id":"t3-hafazan-1.3094d3"},{"j":"mcq","s":"Ayat terakhir Surah Al-Bayyinah ialah ______.","p":["<span class=\"arab\">جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا‌ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُواْ عَنْهُ‌ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ</span>","<span class=\"arab\">أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ</span>","<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>","<span class=\"arab\">وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ</span>"],"a":"<span class=\"arab\">جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا‌ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُواْ عَنْهُ‌ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ</span>","aras":3,"id":"t3-hafazan-1.9af0e5"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span> ialah ______.","p":["<span class=\"arab\">رَسُولٌ مِّنَ ٱللَّهِ يَتْلُواْ صُحُفًا مُّطَهَّرَةً</span>","<span class=\"arab\">فِيهَا كُتُبٌ قَيِّمَةٌ</span>","<span class=\"arab\">وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">وَمَآ أُمِرُوٓاْ إِلَّا لِيَعْبُدُواْ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤْتُواْ ٱلزَّكَوٰةَ‌ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ</span>"],"a":"<span class=\"arab\">رَسُولٌ مِّنَ ٱللَّهِ يَتْلُواْ صُحُفًا مُّطَهَّرَةً</span>","aras":3,"id":"t3-hafazan-1.3f1497"},{"j":"susun","s":"Susun ayat Surah Al-Bayyinah.","susunan":["لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ","رَسُولٌ مِّنَ ٱللَّهِ يَتْلُواْ صُحُفًا مُّطَهَّرَةً","فِيهَا كُتُبٌ قَيِّمَةٌ","وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ","وَمَآ أُمِرُوٓاْ إِلَّا لِيَعْبُدُواْ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤْتُواْ ٱلزَّكَوٰةَ‌ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ"],"aras":3,"id":"t3-hafazan-1.0a5e70"},{"j":"bs","s":"Kita menyembah Allah dengan ikhlas.","a":"Betul","aras":1,"id":"t3-hafazan-1.a6c251"},{"j":"mcq","s":"Pengajaran Surah Al-Bayyinah ialah ______.","p":["kita mendirikan solat dan menunaikan zakat","kita menuntut ilmu dengan membaca dan menulis","kita beriman dan beramal soleh","kita tidak berputus asa"],"a":"kita mendirikan solat dan menunaikan zakat","aras":2,"id":"t3-hafazan-1.155810"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-Bayyinah.","susunan":["وَمَآ أُمِرُوٓاْ إِلَّا لِيَعْبُدُواْ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤْتُواْ ٱلزَّكَوٰةَ‌ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ","إِنَّ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ‌ۚ أُوْلَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ","إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَـٰتِ أُوْلَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ","جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا‌ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُواْ عَنْهُ‌ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ"],"aras":3,"id":"t3-hafazan-1.0e2595"}]},{"id":"t3-hafazan-2","nama":"Surah Al-'Alaq","soalan":[{"j":"mcq","s":"Surah Al-'Alaq mempunyai ______ ayat.","p":["sembilan belas","tujuh belas","lapan belas","dua puluh"],"a":"sembilan belas","aras":1,"id":"t3-hafazan-2.a9d046"},{"j":"mcq","s":"Surah Al-'Alaq ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t3-hafazan-2.181520"},{"j":"mcq","s":"Maksud nama Surah Al-'Alaq ialah ______.","p":["Segumpal darah","Bukti yang nyata","Buah tin","Melapangkan"],"a":"Segumpal darah","aras":1,"id":"t3-hafazan-2.4ce14f"},{"j":"mcq","s":"Ayat pertama Surah Al-'Alaq ialah ______.","p":["<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>","<span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>"],"a":"<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","aras":2,"id":"t3-hafazan-2.547942"},{"j":"isi","s":"Surah Al-'Alaq ialah surah yang ke-96 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-2.e90668"},{"j":"bs","s":"Surah Al-'Alaq ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t3-hafazan-2.069720"},{"j":"bs","s":"Surah Al-'Alaq mempunyai dua puluh ayat.","a":"Salah","aras":1,"id":"t3-hafazan-2.b221bb"},{"j":"mcq","s":"Ayat terakhir Surah Al-'Alaq ialah ______.","p":["<span class=\"arab\">كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩</span>","<span class=\"arab\">أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ</span>","<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>","<span class=\"arab\">وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ</span>"],"a":"<span class=\"arab\">كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩</span>","aras":3,"id":"t3-hafazan-2.117159"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span> ialah ______.","p":["<span class=\"arab\">خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ</span>","<span class=\"arab\">ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ</span>","<span class=\"arab\">ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ</span>","<span class=\"arab\">عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ</span>"],"a":"<span class=\"arab\">خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ</span>","aras":3,"id":"t3-hafazan-2.bd6cd2"},{"j":"susun","s":"Susun ayat Surah Al-'Alaq.","susunan":["ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"],"aras":3,"id":"t3-hafazan-2.b385b3"},{"j":"bs","s":"Wahyu pertama ialah suruhan membaca.","a":"Betul","aras":1,"id":"t3-hafazan-2.1cafd8"},{"j":"mcq","s":"Pengajaran Surah Al-'Alaq ialah ______.","p":["kita menuntut ilmu dengan membaca dan menulis","kita mendirikan solat dan menunaikan zakat","kita beriman dan beramal soleh","kita tidak berputus asa"],"a":"kita menuntut ilmu dengan membaca dan menulis","aras":2,"id":"t3-hafazan-2.112327"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-'Alaq.","susunan":["نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","فَلْيَدْعُ نَادِيَهُۥ","سَنَدْعُ ٱلزَّبَانِيَةَ","كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"],"aras":3,"id":"t3-hafazan-2.03de50"},{"j":"mcq","s":"Ayat ke-10 Surah Al-'Alaq ialah ______.","p":["<span class=\"arab\">عَبْدًا إِذَا صَلَّىٰٓ</span>","<span class=\"arab\">إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ</span>","<span class=\"arab\">أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>"],"a":"<span class=\"arab\">عَبْدًا إِذَا صَلَّىٰٓ</span>","aras":3,"id":"t3-hafazan-2.8d6e9e"}]},{"id":"t3-hafazan-3","nama":"Surah At-Tin","soalan":[{"j":"mcq","s":"Surah At-Tin mempunyai ______ ayat.","p":["lapan","enam","tujuh","sembilan"],"a":"lapan","aras":1,"id":"t3-hafazan-3.cfb957"},{"j":"mcq","s":"Surah At-Tin ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t3-hafazan-3.b2e1e5"},{"j":"mcq","s":"Maksud nama Surah At-Tin ialah ______.","p":["Buah tin","Melapangkan","Waktu dhuha","Malam"],"a":"Buah tin","aras":1,"id":"t3-hafazan-3.ca1940"},{"j":"mcq","s":"Ayat pertama Surah At-Tin ialah ______.","p":["<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>","<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>"],"a":"<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>","aras":2,"id":"t3-hafazan-3.611c80"},{"j":"isi","s":"Surah At-Tin ialah surah yang ke-95 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-3.80a4f6"},{"j":"bs","s":"Surah At-Tin ialah sur