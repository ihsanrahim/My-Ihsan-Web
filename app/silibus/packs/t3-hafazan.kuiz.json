سَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ"],"aras":3,"id":"t3-hafazan-3.b8373f"}]},{"id":"t3-hafazan-4","nama":"Surah Asy-Syarh","soalan":[{"j":"mcq","s":"Surah Asy-Syarh mempunyai ______ ayat.","p":["lapan","enam","tujuh","sembilan"],"a":"lapan","aras":1,"id":"t3-hafazan-4.7201de"},{"j":"mcq","s":"Surah Asy-Syarh ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t3-hafazan-4.06bea9"},{"j":"mcq","s":"Maksud nama Surah Asy-Syarh ialah ______.","p":["Melapangkan","Segumpal darah","Buah tin","Waktu dhuha"],"a":"Melapangkan","aras":1,"id":"t3-hafazan-4.b1892b"},{"j":"mcq","s":"Ayat pertama Surah Asy-Syarh ialah ______.","p":["<span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>","<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>"],"a":"<span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>","aras":2,"id":"t3-hafazan-4.6fef5d"},{"j":"isi","s":"Surah Asy-Syarh ialah surah yang ke-94 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-4.73c3f8"},{"j":"bs","s":"Surah Asy-Syarh ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t3-hafazan-4.5bb7f7"},{"j":"bs","s":"Surah Asy-Syarh mempunyai sembilan ayat.","a":"Salah","aras":1,"id":"t3-hafazan-4.256c7c"},{"j":"mcq","s":"Ayat terakhir Surah Asy-Syarh ialah ______.","p":["<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>","<span class=\"arab\">كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩</span>","<span class=\"arab\">أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ</span>","<span class=\"arab\">وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ</span>"],"a":"<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>","aras":3,"id":"t3-hafazan-4.353d04"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span> ialah ______.","p":["<span class=\"arab\">وَوَضَعْنَا عَنكَ وِزْرَكَ</span>","<span class=\"arab\">ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ</span>","<span class=\"arab\">وَرَفَعْنَا لَكَ ذِكْرَكَ</span>","<span class=\"arab\">فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا</span>"],"a":"<span class=\"arab\">وَوَضَعْنَا عَنكَ وِزْرَكَ</span>","aras":3,"id":"t3-hafazan-4.45049e"},{"j":"susun","s":"Susun ayat Surah Asy-Syarh.","susunan":["أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","وَوَضَعْنَا عَنكَ وِزْرَكَ","ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","وَرَفَعْنَا لَكَ ذِكْرَكَ","فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"],"aras":3,"id":"t3-hafazan-4.25796a"},{"j":"bs","s":"Bersama kesusahan ada kemudahan.","a":"Betul","aras":1,"id":"t3-hafazan-4.294f4f"},{"j":"mcq","s":"Pengajaran Surah Asy-Syarh ialah ______.","p":["kita tidak berputus asa","kita mendirikan solat dan menunaikan zakat","kita menuntut ilmu dengan membaca dan menulis","kita beriman dan beramal soleh"],"a":"kita tidak berputus asa","aras":2,"id":"t3-hafazan-4.ed35a1"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Asy-Syarh.","susunan":["فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","فَإِذَا فَرَغْتَ فَٱنصَبْ","وَإِلَىٰ رَبِّكَ فَٱرْغَب"],"aras":3,"id":"t3-hafazan-4.482a40"}]},{"id":"t3-hafazan-5","nama":"Surah Ad-Duha","soalan":[{"j":"mcq","s":"Surah Ad-Duha mempunyai ______ ayat.","p":["sebelas","sembilan","sepuluh","dua belas"],"a":"sebelas","aras":1,"id":"t3-hafazan-5.5f564d"},{"j":"mcq","s":"Surah Ad-Duha ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t3-hafazan-5.9120f0"},{"j":"mcq","s":"Maksud nama Surah Ad-Duha ialah ______.","p":["Waktu dhuha","Bukti yang nyata","Segumpal darah","Buah tin"],"a":"Waktu dhuha","aras":1,"id":"t3-hafazan-5.81ec19"},{"j":"mcq","s":"Ayat pertama Surah Ad-Duha ialah ______.","p":["<span class=\"arab\">وَٱلضُّحَىٰ</span>","<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>"],"a":"<span class=\"arab\">وَٱلضُّحَىٰ</span>","aras":2,"id":"t3-hafazan-5.878074"},{"j":"isi","s":"Surah Ad-Duha ialah surah yang ke-93 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-5.3dba7b"},{"j":"bs","s":"Surah Ad-Duha ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t3-hafazan-5.5e7300"},{"j":"bs","s":"Surah Ad-Duha mempunyai dua belas ayat.","a":"Salah","aras":1,"id":"t3-hafazan-5.585041"},{"j":"mcq","s":"Ayat terakhir Surah Ad-Duha ialah ______.","p":["<span class=\"arab\">وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ</span>","<span class=\"arab\">كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩</span>","<span class=\"arab\">أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ</span>","<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>"],"a":"<span class=\"arab\">وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ</span>","aras":3,"id":"t3-hafazan-5.ee6515"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">وَٱلضُّحَىٰ</span> ialah ______.","p":["<span class=\"arab\">وَٱلَّيْلِ إِذَا سَجَىٰ</span>","<span class=\"arab\">مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ</span>","<span class=\"arab\">وَلَلْأَخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ</span>","<span class=\"arab\">وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ</span>"],"a":"<span class=\"arab\">وَٱلَّيْلِ إِذَا سَجَىٰ</span>","aras":3,"id":"t3-hafazan-5.158256"},{"j":"susun","s":"Susun ayat Surah Ad-Duha.","susunan":["وَٱلضُّحَىٰ","وَٱلَّيْلِ إِذَا سَجَىٰ","مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","وَلَلْأَخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"],"aras":3,"id":"t3-hafazan-5.741e33"},{"j":"bs","s":"Kita menyayangi anak yatim.","a":"Betul","aras":1,"id":"t3-hafazan-5.5d4943"},{"j":"mcq","s":"Pengajaran Surah Ad-Duha ialah ______.","p":["kita tidak menghardik orang yang meminta","kita mendirikan solat dan menunaikan zakat","kita menuntut ilmu dengan membaca dan menulis","kita beriman dan beramal soleh"],"a":"kita tidak menghardik orang yang meminta","aras":2,"id":"t3-hafazan-5.e5fe5c"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Ad-Duha.","susunan":["وَوَجَدَكَ عَآئِلاً فَأَغْنَىٰ","فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"],"aras":3,"id":"t3-hafazan-5.975ee1"},{"j":"mcq","s":"Ayat ke-6 Surah Ad-Duha ialah ______.","p":["<span class=\"arab\">أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔـاوَىٰ</span>","<span class=\"arab\">وَلَلْأَخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ</span>","<span class=\"arab\">وَوَجَدَكَ عَآئِلاً فَأَغْنَىٰ</span>","<span class=\"arab\">وَٱلضُّحَىٰ</span>"],"a":"<span class=\"arab\">أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔـاوَىٰ</span>","aras":3,"id":"t3-hafazan-5.863f48"}]},{"id":"t3-hafazan-6","nama":"Surah Al-Lail","soalan":[{"j":"mcq","s":"Surah Al-Lail mempunyai ______ ayat.","p":["dua puluh satu","sembilan belas","dua puluh","dua puluh dua"],"a":"dua puluh satu","aras":1,"id":"t3-hafazan-6.3c61e5"},{"j":"mcq","s":"Surah Al-Lail ialah surah ______.","p":["Makkiyyah","Madaniyyah"],"a":"Makkiyyah","aras":1,"id":"t3-hafazan-6.c50c09"},{"j":"mcq","s":"Maksud nama Surah Al-Lail ialah ______.","p":["Malam","Buah tin","Melapangkan","Waktu dhuha"],"a":"Malam","aras":1,"id":"t3-hafazan-6.29f211"},{"j":"mcq","s":"Ayat pertama Surah Al-Lail ialah ______.","p":["<span class=\"arab\">وَٱلَّيْلِ إِذَا يَغْشَىٰ</span>","<span class=\"arab\">لَمْ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ</span>","<span class=\"arab\">ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ</span>","<span class=\"arab\">وَٱلتِّينِ وَٱلزَّيْتُونِ</span>"],"a":"<span class=\"arab\">وَٱلَّيْلِ إِذَا يَغْشَىٰ</span>","aras":2,"id":"t3-hafazan-6.83aa47"},{"j":"isi","s":"Surah Al-Lail ialah surah yang ke-92 dalam ______.","bank":["al-Quran","hadis","kitab Taurat","buku cerita"],"a":"al-Quran","aras":2,"id":"t3-hafazan-6.a3ffca"},{"j":"bs","s":"Surah Al-Lail ialah surah Makkiyyah.","a":"Betul","aras":1,"id":"t3-hafazan-6.65c5bb"},{"j":"bs","s":"Surah Al-Lail mempunyai dua puluh dua ayat.","a":"Salah","aras":1,"id":"t3-hafazan-6.f15313"},{"j":"mcq","s":"Ayat terakhir Surah Al-Lail ialah ______.","p":["<span class=\"arab\">وَلَسَوْفَ يَرْضَىٰ</span>","<span class=\"arab\">كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩</span>","<span class=\"arab\">أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ</span>","<span class=\"arab\">وَإِلَىٰ رَبِّكَ فَٱرْغَب</span>"],"a":"<span class=\"arab\">وَلَسَوْفَ يَرْضَىٰ</span>","aras":3,"id":"t3-hafazan-6.93079c"},{"j":"mcq","s":"Ayat yang selepas <span class=\"arab\">وَٱلَّيْلِ إِذَا يَغْشَىٰ</span> ialah ______.","p":["<span class=\"arab\">وَٱلنَّهَارِ إِذَا تَجَلَّىٰ</span>","<span class=\"arab\">وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ</span>","<span class=\"arab\">إِنَّ سَعْيَكُمْ لَشَتَّىٰ</span>","<span class=\"arab\">فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ</span>"],"a":"<span class=\"arab\">وَٱلنَّهَارِ إِذَا تَجَلَّىٰ</span>","aras":3,"id":"t3-hafazan-6.e2d7a1"},{"j":"susun","s":"Susun ayat Surah Al-Lail.","susunan":["وَٱلَّيْلِ إِذَا يَغْشَىٰ","وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","إِنَّ سَعْيَكُمْ لَشَتَّىٰ","فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"],"aras":3,"id":"t3-hafazan-6.66ec75"},{"j":"bs","s":"Kita bersedekah dan tidak bakhil.","a":"Betul","aras":1,"id":"t3-hafazan-6.786cb9"},{"j":"mcq","s":"Pengajaran Surah Al-Lail ialah ______.","p":["kita bertakwa kepada Allah","kita mendirikan solat dan menunaikan zakat","kita menuntut ilmu dengan membaca dan menulis","kita beriman dan beramal soleh"],"a":"kita bertakwa kepada Allah","aras":2,"id":"t3-hafazan-6.2204a5"},{"j":"susun","s":"Susun ayat yang terakhir dalam Surah Al-Lail.","susunan":["ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","وَلَسَوْفَ يَرْضَىٰ"],"aras":3,"id":"t3-hafazan-6.5400a8"},{"j":"mcq","s":"Ayat ke-11 Surah Al-Lail ialah ______.","p":["<span class=\"arab\">وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ</span>","<span class=\"arab\">وَكَذَّبَ بِٱلْحُسْنَىٰ</span>","<span class=\"arab\">وَإِنَّ لَنَا لَلْأَخِرَةَ وَٱلْأُولَىٰ</span>","<span class=\"arab\">وَٱلَّيْلِ إِذَا يَغْشَىٰ</span>"],"a":"<span class=\"arab\">وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ</span>","aras":3,"id":"t3-hafazan-6.dfab43"}]},{"id":"t3-hafazan-7","nama":"Ulang kaji hafazan Tahun 3","soalan":[{"j":"padankan","s":"Padankan surah dengan maksud namanya.","pasangan":[["At-Tin","Buah tin"],["Ad-Duha","Waktu dhuha"],["Al-Lail","Malam"],["Asy-Syarh","Melapangkan"]],"aras":2,"id":"t3-hafazan-7.c9b88b"},{"j":"mcq","s":"Wahyu yang pertama ialah daripada Surah ______.","p":["Al-'Alaq","Al-Fatihah","At-Tin","Al-Lail"],"a":"Al-'Alaq","aras":2,"id":"t3-hafazan-7.d8afe2"},{"j":"mcq","s":"Surah yang mengajar bersama kesusahan ada kemudahan ialah Surah ______.","p":["Asy-Syarh","Ad-Duha","Al-Bayyinah","At-Tin"],"a":"Asy-Syarh","aras":2,"id":"t3-hafazan-7.24a46d"},{"j":"bs","s":"Surah ad-Duha menyuruh kita menyayangi anak yatim.","a":"Betul","aras":1,"id":"t3-hafazan-7.9d299b"},{"j":"bs","s":"Surah al-Bayyinah ialah surah yang ke-100.","a":"Salah","aras":2,"id":"t3-hafazan-7.3703f2"},{"j":"susun","s":"Susun surah mengikut nombor surah (kecil ke besar).","susunan":["Al-Lail","Ad-Duha","Asy-Syarh","At-Tin","Al-'Alaq"],"aras":3,"id":"t3-hafazan-7.f7e557"}]}]}