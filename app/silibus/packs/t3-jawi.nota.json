{"id":"t3-jawi","tahap":"T3","nama":"Jawi","sk":"JW","ikon":"✍️","warna":"#FF4FA3","bahasa":"ms","kur":"KSSR-S2017","semak":"pending-ustaz","jawi":true,"versi":1,"sumber":"DSKP Pendidikan Islam KSSR (Semakan 2017) — bidang Jawi; Buku Teks Pendidikan Islam Tahun 3 (KPM)","topik":[{"id":"t3-jawi-1","nama":"Huruf ڠ dan ڽ dalam Perkataan","nota":[{"j":"h","t":"Bunyi ng dan ny"},{"j":"p","t":"<b>ڠ (nga)</b> untuk bunyi <i>ng</i>; <b>ڽ (nya)</b> untuk bunyi <i>ny</i>."},{"j":"c","t":"بوڠا = bunga · ڽاموق = nyamuk"},{"j":"p","t":"Apabila perkataan berakhir dengan bunyi <b>ka</b> atau <b>ga</b>, alif di hujung tidak ditulis: تڠݢ = tangga, مڠݢ = mangga."},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["بوڠا","🌸 bunga"],["سيڠا","🦁 singa"],["تڠݢ","🪜 tangga"],["مڠݢ","🥭 mangga"],["ڤيڠݢن","🍽️ pinggan"],["تيڠكڤ","🪟 tingkap"],["بڠكو","bangku"],["لاڠيت","langit"],["ڽاموق","🦟 nyamuk"],["ڽاڽي","🎤 nyanyi"],["باڽق","banyak"],["ميڽق","minyak"],["ڤڽو","🐢 penyu"],["بوڽي","🔔 bunyi"],["سوڽي","sunyi"],["موڽيت","🐒 monyet"],["سڽوم","😊 senyum"],["كوڽيت","kunyit"]]}],"glosari":[]},{"id":"t3-jawi-2","nama":"Kata Berimbuhan Awalan","nota":[{"j":"h","t":"Awalan me-, ber-, ter-, di-"},{"j":"p","t":"{{Imbuhan awalan}} ditulis <b>bersambung</b> dengan kata dasar."},{"j":"c","t":"م + باچ = ممباچ (membaca) · بر + لاري = برلاري (berlari) · د + ماكن = دماكن (dimakan)"},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["ممباچ","📖 membaca"],["منوليس","✏️ menulis"],["ممبلي","membeli"],["مماسق","🍳 memasak"],["منچوچي","mencuci"],["ممبنتو","membantu"],["منولوڠ","menolong"],["برماٴين","bermain"],["برلاري","🏃 berlari"],["برجالن","🚶 berjalan"],["بلاجر","belajar"],["برسيه","bersih"],["ترتيدور","tertidur"],["ترجاتوه","terjatuh"],["دباچ","dibaca"],["دتوليس","ditulis"],["دماكن","dimakan"],["برسوچي","bersuci"]]}],"glosari":[["imbuhan awalan","Imbuhan yang diletakkan di hadapan kata dasar, contohnya me-, ber-, ter-, di-."]]},{"id":"t3-jawi-3","nama":"Kata Berimbuhan Akhiran & Apitan","nota":[{"j":"h","t":"Akhiran -an, -kan, -i"},{"j":"p","t":"{{Imbuhan akhiran}} disambung di hujung kata dasar."},{"j":"c","t":"ماكن + ن = ماكنن (makanan) · مينوم + ن = مينومن (minuman)"},{"j":"p","t":"Jika kata dasar berakhir dengan vokal <b>a</b> dan ditambah <b>-an</b>, hamzah pemisah digunakan: باچاٴن (bacaan)."},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["ماكنن","🍱 makanan"],["مينومن","🧃 minuman"],["باچاٴن","bacaan"],["ڤاكاٴين","👕 pakaian"],["توليسن","tulisan"],["لوكيسن","🖼️ lukisan"],["ماٴينن","🧸 mainan"],["ڤلاجرن","pelajaran"],["كبرسيهن","kebersihan"],["كصيحتن","kesihatan"],["جالنن","jalanan"],["بواتن","buatan"],["تيوڤن","tiupan"],["حرمتي","hormati"],["كباٴيقن","kebaikan"],["كداتاڠن","kedatangan"],["لارين","larian"],["هارين","harian"]]}],"glosari":[["imbuhan akhiran","Imbuhan yang diletakkan di hujung kata dasar, contohnya -an, -kan, -i."]]},{"id":"t3-jawi-4","nama":"Kata Pinjaman Bahasa Arab","nota":[{"j":"h","t":"Istilah agama kekal ejaan Arab"},{"j":"p","t":"Banyak perkataan agama dipinjam daripada bahasa Arab. Ejaannya <b>dikekalkan seperti ejaan asal Arab</b>."},{"j":"c","t":"صلاة = solat · دعاء = doa · مسجد = masjid"},{"j":"tt","t":"Jangan eja ikut bunyi Melayu. <i>Solat</i> bukan «سولت» tetapi «صلاة»."},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["صلاة","🕌 solat"],["دعاء","🤲 doa"],["مسجد","masjid"],["كتاب","📖 kitab"],["علمو","ilmu"],["وضوء","💧 wuduk"],["ايمان","iman"],["إسلام","Islam"],["نبي","nabi"],["رسول","rasul"],["ملائكة","malaikat"],["قرءان","Quran"],["واجب","wajib"],["حرام","haram"],["حلال","halal"],["سنة","sunat"],["نية","niat"],["حرمت","hormat"],["جمعة","Jumaat"],["وحي","wahyu"]]}],"glosari":[["kata pinjaman","Perkataan yang diambil daripada bahasa lain, contohnya bahasa Arab atau Inggeris."]]},{"id":"t3-jawi-5","nama":"Kata Pinjaman Bahasa Inggeris","nota":[{"j":"h","t":"Eja ikut bunyi"},{"j":"p","t":"Kata pinjaman bahasa Inggeris dieja mengikut <b>sebutan Melayu</b>. Bunyi <b>e taling</b> ditulis dengan <b>ي</b>, bunyi <b>o</b> dengan <b>و</b>, dan bunyi <b>v</b> dengan <b>ۏ</b>."},{"j":"c","t":"بس = bas · ڤوليس = polis · تيليۏيشن = televisyen"},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["بس","🚌 bas"],["بيݢ","🎒 beg"],["ڤينسيل","✏️ pensel"],["لوري","🚚 lori"],["تيكسي","🚕 teksi"],["ڤوليس","👮 polis"],["دوكتور","🧑‍⚕️ doktor"],["راديو","📻 radio"],["كاميرا","📷 kamera"],["تيليفون","📞 telefon"],["تيليۏيشن","📺 televisyen"],["كومڤوتر","💻 komputer"],["هوسڤيتل","🏥 hospital"],["ساٴينس","🔬 sains"],["ماتيماتيك","matematik"],["كلس","kelas"],["كنتين","kantin"],["ستوكين","🧦 stokin"],["ۏان","🚐 van"],["ايڤل","🍎 epal"]]}],"glosari":[]},{"id":"t3-jawi-6","nama":"Nombor & Hari","nota":[{"j":"h","t":"Nombor dan nama hari"},{"j":"p","t":"Nama hari berasal daripada bahasa Arab, jadi ejaannya mengikut ejaan Arab."},{"j":"c","t":"احد = Ahad · اثنين = Isnin · خميس = Khamis · جمعة = Jumaat"},{"j":"h","t":"Senarai perkataan"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["ساتو","satu"],["دوا","dua"],["تيݢ","tiga"],["امڤت","empat"],["ليما","lima"],["انم","enam"],["توجوه","tujuh"],["لاڤن","lapan"],["سمبيلن","sembilan"],["سڤولوه","sepuluh"],["احد","Ahad"],["اثنين","Isnin"],["سلاس","Selasa"],["رابو","Rabu"],["خميس","Khamis"],["جمعة","Jumaat"],["سبتو","Sabtu"],["هاري","hari"]]}],"glosari":[]},{"id":"t3-jawi-7","nama":"Ucapan & Rangkai Kata","nota":[{"j":"h","t":"Ucapan harian"},{"j":"c","t":"سلامت ڤاݢي = selamat pagi · تريما كاسيه = terima kasih"},{"j":"p","t":"Ucapan Arab seperti <b>السلام عليكم</b> dan <b>الحمد لله</b> ditulis mengikut ejaan Arab."},{"j":"h","t":"Rangkai kata"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["سلامت ڤاݢي","🌅 selamat pagi"],["سلامت داتڠ","selamat datang"],["سلامت جالن","👋 selamat jalan"],["تريما كاسيه","🙏 terima kasih"],["هاري راي","hari raya"],["هاري جمعة","hari Jumaat"],["اٴير مينومن","air minuman"],["بوكو باچاٴن","buku bacaan"],["ماكنن حلال","makanan halal"],["صلاة جمعة","solat Jumaat"],["باچ دعاء","baca doa"],["ݢورو كلس","guru kelas"],["بس سكوله","🚌 bas sekolah"],["كتاب سوچي","kitab suci"],["علمو ساٴينس","ilmu sains"],["انق باٴيق","anak baik"],["رومه بسر","rumah besar"],["كاون باٴيق","kawan baik"]]}],"glosari":[]},{"id":"t3-jawi-8","nama":"Ayat & Teks Pendek","nota":[{"j":"h","t":"Membaca ayat Jawi dengan lancar"},{"j":"p","t":"Baca seluruh ayat, kemudian fahamkan maksudnya."},{"j":"c","t":"ساي برجالن ك سكوله. = Saya berjalan ke sekolah."},{"j":"h","t":"Ayat"},{"j":"t","kepala":["Jawi","Rumi"],"baris":[["ساي برجالن ك سكوله.","Saya berjalan ke sekolah."],["اديق بلاجر منوليس جاوي.","Adik belajar menulis Jawi."],["كاكق ممباچ كتاب.","Kakak membaca kitab."],["ايبو مماسق ماكنن.","Ibu memasak makanan."],["باڤ صلاة د مسجد.","Bapa solat di masjid."],["كامي برماٴين د كنتين.","Kami bermain di kantin."],["ݢورو منوليس د ڤاڤن هيتم.","Guru menulis di papan hitam."],["ديا ناٴيق بس سكوله.","Dia naik bas sekolah."],["دوكتور ايت باٴيق.","Doktor itu baik."],["هاري اين هاري جمعة.","Hari ini hari Jumaat."],["ساي حرمتي ݢورو.","Saya hormati guru."],["كيت باچ دعاء ماكن.","Kita baca doa makan."],["اٴير ايت برسيه.","Air itu bersih."],["ڤوليس منولوڠ داتوق.","Polis menolong datuk."],["ساي سوك علمو ساٴينس.","Saya suka ilmu sains."],["ماكنن ايت حلال.","Makanan itu halal."]]}],"glosari":[]}]}