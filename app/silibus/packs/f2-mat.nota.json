{"bahasa":"ms","kur":"KSSM","semak":"pending-guru","jawi":false,"tahap":"F2","id":"f2-mat","nama":"Matematik","sk":"MT","ikon":"🔢","warna":"#F0A030","versi":1,"sumber":"DSKP KSSM Matematik Tingkatan 2 (KPM). Semua nota dan soalan ditulis untuk aplikasi.","topik":[{"id":"f2-mat-1","nama":"1. Pola dan Jujukan","nota":[{"j":"h","t":"Pola dan jujukan"},{"j":"l","t":["Jujukan aritmetik: tambah beza sepunya.","Sebutan ke-n: Tn = a + (n − 1)d."]}]},{"id":"f2-mat-2","nama":"2. Pemfaktoran dan Pecahan Algebra","nota":[{"j":"h","t":"Pemfaktoran"},{"j":"l","t":["(a + b)(c + d) = ac + ad + bc + bd","a² − b² = (a + b)(a − b)","Faktor sepunya: 6x + 9 = 3(2x + 3)"]}]},{"id":"f2-mat-3","nama":"3. Rumus Algebra","nota":[{"j":"h","t":"Rumus algebra"},{"j":"l","t":["Perkara rumus: pemboleh ubah yang diasingkan di sebelah kiri.","Gantikan nilai untuk mencari pemboleh ubah."]}]},{"id":"f2-mat-4","nama":"4. Poligon","nota":[{"j":"h","t":"Poligon"},{"j":"l","t":["Hasil tambah sudut pedalaman = (n − 2) × 180°.","Hasil tambah sudut peluaran = 360°.","Poligon sekata: sudut peluaran = 360° ÷ n."]}]},{"id":"f2-mat-5","nama":"5. Bulatan","nota":[{"j":"h","t":"Bulatan"},{"j":"l","t":["Lilitan = 2πj = πd.","Luas = πj².","π ≈ 22/7 atau 3.142."]}]},{"id":"f2-mat-6","nama":"6. Bentuk Geometri Tiga Dimensi","nota":[{"j":"h","t":"Bentuk 3D"},{"j":"l","t":["Kubus/kuboid: 6 muka, 12 tepi, 8 bucu.","Isi padu prisma = luas keratan rentas × panjang.","Silinder: πj²t."]}]},{"id":"f2-mat-7","nama":"7. Koordinat","nota":[{"j":"h","t":"Koordinat"},{"j":"l","t":["Jarak = √((x₂ − x₁)² + (y₂ − y₁)²).","Titik tengah = ((x₁ + x₂)/2, (y₁ + y₂)/2)."]}]},{"id":"f2-mat-8","nama":"8. Graf Fungsi","nota":[{"j":"h","t":"Fungsi"},{"j":"l","t":["Fungsi linear: graf garis lurus.","Fungsi kuadratik y = x²: graf parabola."]}]},{"id":"f2-mat-9","nama":"9. Laju dan Pecutan","nota":[{"j":"h","t":"Laju dan pecutan"},{"j":"l","t":["Laju = jarak ÷ masa.","Pecutan = (halaju akhir − halaju awal) ÷ masa."]}]},{"id":"f2-mat-10","nama":"10. Kecerunan Garis Lurus","nota":[{"j":"h","t":"Kecerunan"},{"j":"l","t":["m = (y₂ − y₁)/(x₂ − x₁).","y = mx + c: m kecerunan, c pintasan-y."]}]},{"id":"f2-mat-11","nama":"11. Transformasi Isometri","nota":[{"j":"h","t":"Transformasi"},{"j":"l","t":["Translasi (a, b): (x, y) → (x + a, y + b).","Pantulan paksi-x: (x, −y); paksi-y: (−x, y)."]}]},{"id":"f2-mat-12","nama":"12. Sukatan Kecenderungan Memusat","nota":[{"j":"h","t":"Min, median, mod"},{"j":"l","t":["Min = jumlah ÷ bilangan.","Median: nilai tengah data tersusun.","Mod: nilai paling kerap."]}]},{"id":"f2-mat-13","nama":"13. Kebarangkalian Mudah","nota":[{"j":"h","t":"Kebarangkalian"},{"j":"l","t":["P(A) = bilangan kesudahan A ÷ bilangan ruang sampel.","0 ≤ P(A) ≤ 1."]}]},{"id":"f2-mat-u1","nama":"Ujian Akhir Sesi (contoh)","nota":[{"j":"h","t":"Format ujian contoh"},{"j":"p","t":"52 soalan daripada setiap bab, dari mudah hingga sukar. Cadangan masa: 1 jam."},{"j":"tt","t":"Format sebenar UASA ditetapkan oleh KPM dan sekolah."}]}]}